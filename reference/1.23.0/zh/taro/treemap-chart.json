  "documentationContext": {
    "translationResources": {
      "title": "矩形树图",
      "description": "以面积与数值成正比的嵌套矩形展示层级数据，一眼看出哪些部分占用最多（磁盘占用、预算、投资组合）。悬停或使用方向键高亮单元格；提示框会显示其路径。",
      "demos": {
        "basic": {
          "title": "嵌套",
          "description": "父节点汇总子节点的值，并以标题显示名称；onClick 返回从根到被点击叶子节点的路径。"
        },
        "flat": {
          "title": "扁平",
          "description": "没有子节点时每个节点都是叶子；gap 加大单元格之间的间距。"
        },
        "market-map": {
          "title": "股市热力图",
          "description": "按板块分组的股票，面积表示市值，颜色从红到绿表示当日涨跌，就像财经网站上的市场全景图；涨跌幅写在每个单元格的名称中。"
        },
        "bundle": {
          "title": "打包体积",
          "description": "打包分析工具的视图：按压缩后体积展示 JavaScript 包中的模块，共三层，图表下方列出最大的依赖。"
        },
        "drill-down": {
          "title": "下钻商品目录",
          "description": "点击某个类别（onClick，使用 event.path 的第一个名称）会将数据替换为其子类别和品牌，面包屑可返回总览。进入类别后，点击会选中某个品牌；renderTooltip 会在路径前加上类别。"
        },
        "cloud-costs": {
          "title": "带图例筛选的云成本",
          "description": "legend={{ position: \"top\" }} 列出各项服务；hidden 和 onToggle 让筛选成为受控状态，因此“全部显示”按钮可以重置它，摘要也能汇总剩余的服务。renderTooltip 显示某项资源占整个账单的比例。"
        },
        "live-cluster": {
          "title": "实时集群内存",
          "description": "每个 Pod 使用的内存每 2 秒刷新一次（setInterval，在关闭开关或卸载时清除），单元格原地调整大小。超过内存上限 85% 的 Pod 通过 color 变为红色，并且只播报这类 Pod 的列表。"
        },
        "metric-switch": {
          "title": "切换指标",
          "description": "同一棵树可以按收入、订单数或利润确定大小，因此切换指标时单元格会移动和缩放而不是重新绘制；format 随指标变化。国家名称来自 Intl.DisplayNames，renderTooltip 列出某个国家的所有指标。"
        }
      },
