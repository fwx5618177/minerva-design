      "files": {
        "apps/docs/src/docs/pages/form-layout/native/basic.tsx": "import {\n  FormLayout,\n  FormControl,\n  FormLabel,\n  Input,\n} from \"minerva-design/native\";\nexport default function Basic() {\n  return (\n    <FormLayout columns={{ base: 1, md: 2 }}>\n      <FormControl>\n        <FormLabel>First name</FormLabel>\n        <Input />\n      </FormControl>\n      <FormControl>\n        <FormLabel>Last name</FormLabel>\n        <Input />\n      </FormControl>\n    </FormLayout>\n  );\n}\n"
      },
      "dependencies": [
        "minerva-design"
      ],
      "contextImports": [],
      "title": "基础用法",
      "description": "columns 跟随表单自身宽度；GridItem fullWidth asChild 让 FormField 占满整行且不额外包裹。"
    }
