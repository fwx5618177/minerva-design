  "documentationContext": {
    "translationResources": {
      "title": "Stack",
      "description": "Primitives de mise en page flex (Stack, HStack, VStack) avec des espacements par jetons, des séparateurs et des groupes accolés. Les enfants ne sont pas enveloppés.",
      "demos": {
        "basic": {
          "title": "Pile verticale",
          "description": "VStack empile les enfants en colonne et les étire par défaut."
        },
        "horizontal": {
          "title": "Pile horizontale",
          "description": "HStack centre les éléments sur l'axe secondaire ; justify les répartit."
        },
        "gap": {
          "title": "Espacement",
          "description": "Les nombres sélectionnent des jetons d’espacement (2 = 8 px, 4 = 16 px, 6 = 24 px) ; les autres chaînes sont des longueurs CSS."
        },
        "wrap": {
          "title": "Retour à la ligne et sémantique",
          "description": "wrap permet le retour à la ligne ; as rend une liste."
        },
        "separator": {
          "title": "Séparateur",
          "description": "separator s’affiche entre les éléments, par exemple un Divider vertical ; les enfants vides n’en reçoivent pas."
        },
        "attached": {
          "title": "Groupe accolé",
          "description": "attached réunit les éléments en un seul groupe aux bordures partagées et aux seuls coins extérieurs arrondis, comme un contrôle segmenté."
        }
      },
      "api": {
        "StackProps": {
          "ref": "Ref vers l'élément rendu",
          "as": "Élément ou composant à rendre",
          "direction": "Direction flex",
          "gap": "Espace entre les éléments : nombres et chaînes numériques = jetons, autres chaînes = valeurs CSS. Aucun espace si omis.",
          "align": "Alignement sur l'axe secondaire (align-items) ; non défini si omis",
          "justify": "Répartition sur l'axe principal (justify-content) ; non défini si omis",
          "wrap": "Fait passer les éléments sur plusieurs lignes",
          "separator": "Affiché entre deux éléments (ni avant le premier ni après le dernier) ; les enfants vides n’en reçoivent pas",
          "attached": "Réunit les éléments en un groupe accolé : sans espacement, bordures partagées, coins extérieurs arrondis et role=\"group\""
        }
      },
      "cssVars": {
        "--stack-gap": "Espace entre les enfants quand la prop gap n'est pas définie (par défaut 0)"
      },
      "wc": {
        "demos": {
          "basic": {
            "title": "Utilisation de base",
            "description": "Une colonne d'éléments avec un espacement issu des jetons (gap=\"3\" vaut var(--space-3)). Les enfants sont insérés tels quels, sans enveloppe."
          },
          "hstack-vstack": {
            "title": "HStack, VStack et alignement",
            "description": "<minerva-hstack> est une ligne centrée sur l'axe secondaire, <minerva-vstack> une colonne étirée ; align, justify et direction (y compris les sens inversés) les ajustent."
          },
          "wrap-separator": {
            "title": "Séparateurs et retour à la ligne",
            "description": "separator insère un texte entre les éléments ou, défini comme propriété JS, une fonction qui renvoie un contenu neuf à chaque intervalle (ici un séparateur vertical). wrap permet aux éléments de passer sur plusieurs lignes. Les séparateurs utilisent l'assignation manuelle des slots ; dans les navigateurs sans slot.assign() (Safari < 16.4), la pile se rabat sur des slots nommés (un attribut slot=\"minerva-stack-item-n\" sur chaque enfant élément tant qu'un séparateur est défini), si bien que les séparateurs apparaissent toujours entre les enfants éléments (enveloppez le texte nu dans un élément)."
          },
          "attached": {
            "title": "Groupes accolés",
            "description": "attached réunit les éléments en un seul groupe (sans espacement, bordures partagées) exposé en role=\"group\" ; nommez-le avec aria-label."
          }
        },
        "minerva-stack": {
          "slots": {
            "default": "Éléments."
          }
        },
        "minerva-hstack": {
          "slots": {
            "default": "Éléments, disposés en ligne."
          }
        },
        "minerva-vstack": {
          "slots": {
            "default": "Éléments, disposés en colonne."
          }
        }
      },
      "native": {
        "demos": {
          "basic": {
            "title": "Exemple natif",
