    "translationResources": {
      "title": "Box 盒子",
      "description": "多态容器，提供间距、尺寸、背景、圆角和阴影的简写属性。",
      "demos": {
        "basic": {
          "title": "基础用法",
          "description": "数字间距对应 token（4 -> var(--space-4)）；bg 支持表面别名。"
        },
        "sizing": {
          "title": "尺寸与居中",
          "description": "尺寸属性接受像素或 CSS 长度；mx=\"auto\" 使限宽盒子居中。"
        },
        "polymorphic": {
          "title": "多态元素",
          "description": "使用 as 渲染 ul / li 或 section 等语义元素。"
        }
      },
      "api": {
        "BoxProps": {
          "ref": "指向渲染元素的 ref",
          "as": "要渲染的元素或组件",
          "p": "四边内边距（间距 token 或 CSS 值）",
          "px": "水平方向内边距（间距 token 或 CSS 值）",
          "py": "垂直方向内边距（间距 token 或 CSS 值）",
          "pt": "顶部内边距（间距 token 或 CSS 值）",
          "pr": "右侧内边距（间距 token 或 CSS 值）",
          "pb": "底部内边距（间距 token 或 CSS 值）",
          "pl": "左侧内边距（间距 token 或 CSS 值）",
          "m": "四边外边距（间距 token 或 \"auto\" 等 CSS 值）",
          "mx": "水平方向外边距（间距 token 或 \"auto\" 等 CSS 值）",
          "my": "垂直方向外边距（间距 token 或 \"auto\" 等 CSS 值）",
          "mt": "顶部外边距（间距 token 或 \"auto\" 等 CSS 值）",
          "mr": "右侧外边距（间距 token 或 \"auto\" 等 CSS 值）",
          "mb": "底部外边距（间距 token 或 \"auto\" 等 CSS 值）",
          "ml": "左侧外边距（间距 token 或 \"auto\" 等 CSS 值）",
          "w": "宽度：数字为像素，字符串为 CSS 长度",
          "h": "高度：数字为像素，字符串为 CSS 长度",
          "minW": "最小宽度",
          "minH": "最小高度",
          "maxW": "最大宽度",
          "maxH": "最大高度",
          "bg": "背景：表面别名（bg、bg.subtle、bg.muted、bg.canvas、bg.elevated、bg.emphasis）或任意 CSS 背景值",
          "rounded": "圆角：圆角 token（none、sm、md、lg、xl、2xl、full）或任意 CSS 值",
          "boxShadow": "阴影：阴影 token（sm、md、lg、xl）或任意 CSS 值",
          "border": "CSS border 简写，原样使用"
        }
      },
      "wc": {
        "demos": {
          "basic": {
            "title": "基本用法",
            "description": "元素本身就是盒子：p、bg、rounded、box-shadow 和 border 都作用于宿主元素。"
          },
          "spacing-sizing": {
            "title": "间距与尺寸",
            "description": "数字会选择间距令牌（p=\"4\" 即 var(--space-4)），其他字符串作为 CSS 值；尺寸（w、h、min-/max-）为像素或 CSS 长度。单边属性优先于轴向属性，轴向属性优先于四边简写。"
          },
          "surfaces": {
            "title": "表面、圆角与阴影",
            "description": "bg 接受表面别名（bg、bg.subtle、bg.muted、bg.canvas、bg.elevated）或任意 CSS 背景；rounded 和 box-shadow 接受令牌或 CSS 值。"
          }
