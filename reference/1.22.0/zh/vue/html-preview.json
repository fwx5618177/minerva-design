  "examples": [
    {
      "id": "basic",
      "kind": "internal-demo",
      "entry": "apps/docs/src/docs/pages/html-preview/vue/basic.vue",
      "files": {
        "apps/docs/src/docs/pages/html-preview/vue/basic.vue": "<script setup lang=\"ts\">\nimport { HtmlPreview } from \"minerva-design/vue\";\n</script>\n<template>\n  <HtmlPreview\n    html=\"<h1>Hello Minerva</h1><p>A sandboxed document preview.</p>\"\n    title=\"Welcome document\"\n    :height=\"220\"\n  />\n</template>\n"
      },
      "dependencies": [
        "minerva-design"
      ],
      "contextImports": [],
      "title": "basic",
      "description": ""
    },
    {
      "id": "sanitized",
      "kind": "internal-demo",
      "entry": "apps/docs/src/docs/pages/html-preview/vue/sanitized.vue",
      "files": {
        "apps/docs/src/docs/pages/html-preview/vue/sanitized.vue": "<script setup lang=\"ts\">\nimport { HtmlPreview, VStack } from \"minerva-design/vue\";\nconst html =\n  '<h2>Safe preview</h2><img src=\"x\" onerror=\"alert(1)\"><a href=\"javascript:alert(1)\">Unsafe link</a><p>Ordinary content remains visible.</p>';\n</script>\n<template>\n  <VStack :gap=\"3\" align=\"stretch\"\n    ><HtmlPreview :html=\"html\" title=\"Sanitized document\" :height=\"220\" />\n    <p>\n      Unsafe scripts and event handlers are removed; the preview stays\n      sandboxed.\n    </p></VStack\n  >\n</template>\n"
      },
      "dependencies": [
        "minerva-design"
      ],
      "contextImports": [],
      "title": "sanitized",
      "description": ""
    },
    {
      "id": "viewport",
      "kind": "internal-demo",
      "entry": "apps/docs/src/docs/pages/html-preview/vue/viewport.vue",
      "files": {
        "apps/docs/src/docs/pages/html-preview/vue/viewport.vue": "<script setup lang=\"ts\">\nimport { ref } from \"vue\";\nimport { HtmlPreview, Button, VStack } from \"minerva-design/vue\";\nconst mobile = ref(true);\n</script>\n<template>\n  <VStack :gap=\"3\" align=\"stretch\"\n    ><Button @click=\"mobile = !mobile\">{{\n      mobile ? \"Switch to desktop\" : \"Switch to mobile\"\n    }}</Button\n    ><HtmlPreview\n      html=\"<h2>Responsive preview</h2><p>Inspect content at different viewport widths.</p>\"\n      title=\"Responsive document\"\n      :viewport=\"mobile ? 'mobile' : 'desktop'\"\n      :mobile-width=\"320\"\n      :height=\"220\"\n  /></VStack>\n</template>\n"
      },
      "dependencies": [
        "minerva-design",
        "vue"
      ],
      "contextImports": [],
      "title": "viewport",
      "description": ""
    }
  ],
