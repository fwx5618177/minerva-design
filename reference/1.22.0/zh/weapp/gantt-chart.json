  "documentationContext": {
    "translationResources": {
      "title": "甘特图",
      "description": "在时间轴上以条形表示任务，显示进度、分组、里程碑和今日线；可沿时间缩放和平移。",
      "demos": {
        "project": {
          "title": "项目计划",
          "description": "每个分组有自己的颜色和图例项，进度以实心条覆盖在任务上，里程碑显示为圆点，today 在指定日期画一条线。悬停任务时，提示框只显示该任务：所属分组、起止日期、时长、进度和前置任务。依赖关系以箭头绘制。"
        },
        "dependencies": {
          "title": "依赖关系",
          "description": "每个任务在 dependencies 中列出它所等待的任务：从每个前置任务的结束处到该任务的开始处画一条折线箭头；任务在前置任务结束之前开始时，箭头从两行之间绕行，里程碑同样适用。dependencyArrows: false 只在提示框中列出依赖；dependencyColor 设置箭头颜色。"
        },
        "roadmap": {
          "title": "路线图",
          "description": "按团队划分的年度路线图：yAxis.min 和 max 固定时间范围；Ctrl / ⌘ + 滚轮（或双指缩放）沿时间缩放，拖动可平移。"
        },
        "sprint": {
          "title": "迭代",
          "description": "精确到小时的任务，每位开发者一种颜色；onPointClick 接收被点击的行并显示其详情。"
        },
        "locale": {
          "title": "多语言与 UTC 日期",
          "description": "locale 决定月份和星期名称、进度百分比以及默认名称（任务、进度、里程碑）；yAxis.timeZone: \"utc\" 按 UTC 排列日期，UTC 数据在任何时区都保持对齐。"
        },
        "crews": {
          "title": "共用行",
          "description": "按施工队排列的施工计划：row 把多个任务放在同一行，dependencies 引用任务 id，因此每条箭头都连接确切的条形。箭头在避开其他条形的通道中穿过各行；没有空闲通道时，则沿两行之间的间隙拐弯（从基坑开挖到基础浇筑，绕开钢筋笼）。"
        },
        "release-train": {
          "title": "发布火车",
          "description": "三个团队的一个项目增量（PI）：row 把同一团队的特性放在一行，group 区分特性和使能项，时间轴上的 rect 标注为各迭代加底色，并突出创新与规划（IP）迭代。系统演示是单独一行中的里程碑。"
        },
        "critical-path": {
          "title": "关键路径",
          "description": "根据工期和依赖计算最早和最迟开始时间（关键路径法）。打开开关后，group 把任务分为关键任务和有浮动时间的任务，colors 将它们涂成红色和灰色；onPointClick 报告被点击任务的浮动时间。"
        },
        "resources": {
          "title": "资源计划",
          "description": "每人一行（row），每个项目一种颜色（group；Select 筛选项目时 colors 保持每个项目的颜色），yAxis.min / max 固定六周。onHover 读取悬停的行（event.xLabel），显示此人的负荷，包括超额分配。"
        },
        "live-deploy": {
          "title": "实时流水线运行",
          "description": "用 setInterval 回放一次部署流水线（在暂停和卸载时清除）：today 跟随模拟时钟，每个进度据此重新计算，interaction={false} 让时间范围在图表更新时保持不动。"
        },
        "onboarding": {
          "title": "入职计划",
          "description": "renderTooltip 用 React 内容替换提示框：根据 seriesId（每组一个系列，外加里程碑）和 index 找到悬停的条形，显示负责人、用 Intl.DateTimeFormat 的 formatRange 格式化的日期，以及相对于今天的状态。"
        },
        "daily": {
          "title": "泳道：一天的日程",
          "description": "按优先级分泳道的单日日程：row 相同的任务共用一条泳道，时间范围对齐到整点（08:00–22:00）并以时:分显示刻度，group 按类型为任务着色，today 画出当前时间。由于每条泳道有多个任务，barLabels（默认 \"auto\"）会把任务名写在条形内部，过长时以省略号截断，并使用与条形对比明显的文字颜色。没有 progress 的任务画成实心条；进行中的代码评审以半透明显示剩余部分。"
        }
      },
      "native": {
        "demos": {
          "basic": {
            "title": "基础用法",
            "description": "按阶段分组的任务及其进度，以及发布里程碑；双指缩放时间轴，拖动平移。"
          },
          "daily": {
            "title": "一天的日程",
            "description": "按优先级分泳道，每条泳道有多个任务（row），任务名写在条形内部（barLabels），单日范围使用整点刻度，并在当前时间画线；没有 progress 的任务画成实心条。"
          }
        }
      },
