  "examples": [
    {
      "id": "basic",
      "kind": "internal-demo",
      "entry": "apps/docs/src/docs/pages/image-preview/native/basic.tsx",
      "files": {
        "apps/docs/src/docs/pages/image-preview/native/basic.tsx": "import { useState } from \"react\";\nimport { Image, View } from \"react-native\";\nimport { Button, ImagePreview } from \"minerva-design/native\";\n\nconst IMAGES = [1015, 1016, 1018, 1019].map(\n  (id) => `https://picsum.photos/id/${id}/600/400`,\n);\n\nexport default function Basic() {\n  const [start, setStart] = useState<number | null>(null);\n  return (\n    <View style={{ flexDirection: \"row\", flexWrap: \"wrap\", gap: 8 }}>\n      {IMAGES.map((uri, i) => (\n        <Button\n          variant=\"ghost\"\n          style={{ paddingHorizontal: 0, paddingVertical: 0 }}\n          key={uri}\n          accessibilityRole=\"imagebutton\"\n          accessibilityLabel={`Hotel photo ${i + 1}`}\n          onPress={() => setStart(i)}\n        >\n          <Image\n            source={{ uri }}\n            style={{ width: 80, height: 80, borderRadius: 8 }}\n          />\n        </Button>\n      ))}\n      <ImagePreview\n        images={IMAGES}\n        open={start !== null}\n        index={start ?? 0}\n        onChange={setStart}\n        onOpenChange={(open) => !open && setStart(null)}\n      />\n    </View>\n  );\n}\n"
      },
      "dependencies": [
        "minerva-design",
        "react",
        "react-native"
      ],
      "contextImports": [],
      "title": "basic",
      "description": ""
    },
    {
      "id": "controlled",
      "kind": "internal-demo",
      "entry": "apps/docs/src/docs/pages/image-preview/native/controlled.tsx",
      "files": {
        "apps/docs/src/docs/pages/image-preview/native/controlled.tsx": "import { useState } from \"react\";\nimport { Text, View } from \"react-native\";\nimport { Button, ImagePreview, useTheme } from \"minerva-design/native\";\n\nconst IMAGES = [1040, 1043, 1044, 1047, 1050].map(\n  (id) => `https://picsum.photos/id/${id}/600/400`,\n);\n\nexport default function Controlled() {\n  const { colors } = useTheme();\n  const [open, setOpen] = useState(false);\n  const [index, setIndex] = useState(2);\n  const [reason, setReason] = useState(\"-\");\n  return (\n    <View style={{ gap: 12 }}>\n      <Button onPress={() => setOpen(true)}>View review photos</Button>\n      <Text style={{ color: colors[\"text-secondary-color\"] }}>\n        Photo {index + 1} of {IMAGES.length} · last closed by: {reason}\n      </Text>\n      <ImagePreview\n        images={IMAGES}\n        open={open}\n        onOpenChange={(next, why) => {\n          setOpen(next);\n          if (why) setReason(why);\n        }}\n        index={index}\n        onChange={setIndex}\n        closeOnPress={false}\n      />\n    </View>\n  );\n}\n"
      },
      "dependencies": [
        "minerva-design",
        "react",
        "react-native"
      ],
      "contextImports": [],
      "title": "controlled",
      "description": ""
    }
  ],
