  "examples": [
    {
      "id": "basic",
      "kind": "internal-demo",
      "entry": "apps/docs/src/docs/pages/card/vue/basic.vue",
      "files": {
        "apps/docs/src/docs/pages/card/vue/basic.vue": "<script setup lang=\"ts\">\nimport { ref } from \"vue\";\nimport {\n  Button,\n  Card,\n  CardHeader,\n  CardTitle,\n  CardDescription,\n  CardContent,\n  CardFooter,\n} from \"minerva-design/vue\";\nconst opened = ref(false);\n</script>\n<template>\n  <div style=\"width: 340px\">\n    <Card\n      ><CardHeader\n        ><CardTitle>Project Apollo</CardTitle\n        ><CardDescription>Updated 2 hours ago</CardDescription></CardHeader\n      ><CardContent\n        >A design system for building accessible, themeable\n        interfaces.</CardContent\n      ><CardFooter\n        ><Button size=\"small\" @click=\"opened = true\">Open</Button></CardFooter\n      ></Card\n    >\n    <p v-if=\"opened\" role=\"status\">Opened Project Apollo</p>\n  </div>\n</template>\n"
      },
      "dependencies": [
        "minerva-design",
        "vue"
      ],
      "contextImports": [],
      "title": "basic",
      "description": ""
    },
    {
      "id": "interactive",
      "kind": "internal-demo",
      "entry": "apps/docs/src/docs/pages/card/vue/interactive.vue",
      "files": {
        "apps/docs/src/docs/pages/card/vue/interactive.vue": "<script setup lang=\"ts\">\nimport { ref } from \"vue\";\nimport { Card, CardContent, VStack } from \"minerva-design/vue\";\nconst count = ref(0);\n</script>\n<template>\n  <VStack :gap=\"3\" align=\"stretch\"\n    ><Card interactive tabindex=\"0\" @click=\"count++\" @keydown.enter=\"count++\"\n      ><CardContent\n        ><h3>Open project</h3>\n        <p>Activate this interactive card.</p></CardContent\n      ></Card\n    ><output>Opened {{ count }} times</output></VStack\n  >\n</template>\n"
      },
      "dependencies": [
        "minerva-design",
        "vue"
      ],
      "contextImports": [],
      "title": "interactive",
      "description": ""
    },
    {
      "id": "padded",
      "kind": "internal-demo",
      "entry": "apps/docs/src/docs/pages/card/vue/padded.vue",
      "files": {
        "apps/docs/src/docs/pages/card/vue/padded.vue": "<script setup lang=\"ts\">\nimport { Card, CardContent, VStack } from \"minerva-design/vue\";\n</script>\n<template>\n  <VStack :gap=\"3\" align=\"stretch\"\n    ><Card\n      ><CardContent\n        ><h3>Standard padding</h3>\n        <p>CardContent applies consistent internal spacing.</p></CardContent\n      ></Card\n    ><Card\n      ><CardContent style=\"padding: 32px\"\n        ><h3>Custom content spacing</h3>\n        <p>Override padding for a more spacious surface.</p></CardContent\n      ></Card\n    ></VStack\n  >\n</template>\n"
      },
      "dependencies": [
        "minerva-design"
      ],
      "contextImports": [],
      "title": "padded",
      "description": ""
    },
    {
      "id": "variants",
      "kind": "internal-demo",
      "entry": "apps/docs/src/docs/pages/card/vue/variants.vue",
      "files": {
        "apps/docs/src/docs/pages/card/vue/variants.vue": "<script setup lang=\"ts\">\nimport { Card, CardHeader, CardTitle, CardContent } from \"minerva-design/vue\";\nconst variants = [\"default\", \"outline\", \"elevated\", \"filled\", \"ghost\"] as const;\n</script>\n<template>\n  <div\n    style=\"\n      display: grid;\n      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));\n      gap: 16px;\n      width: 100%;\n    \"\n  >\n    <Card v-for=\"variant in variants\" :key=\"variant\" :variant=\"variant\"\n      ><CardHeader\n        ><CardTitle>{{ variant }}</CardTitle></CardHeader\n      ><CardContent>variant=\"{{ variant }}\"</CardContent></Card\n    >\n  </div>\n</template>\n"
      },
      "dependencies": [
        "minerva-design"
      ],
      "contextImports": [],
      "title": "variants",
      "description": ""
    }
