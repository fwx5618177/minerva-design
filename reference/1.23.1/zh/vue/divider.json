          {
            "name": "flexItem",
            "type": "boolean",
            "default": "false",
            "required": false,
            "description": "Vertical divider inside a flex container: stretches to the container\nheight (align-self: stretch) instead of the 1em inline height",
            "typeText": "boolean"
          }
        ],
        "events": [],
        "slots": [
          {
            "name": "default",
