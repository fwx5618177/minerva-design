    "translationResources": {
      "title": "热力图",
      "description": "按数值着色的单元格网格，两个轴都可以是类目或数字：按星期和小时的活跃度、相关性矩阵、某项指标的分布图等。悬停单元格会将其浮起、高亮所在行列，并在色例上标出其数值。",
      "demos": {
        "basic": {
          "title": "每周活跃度",
          "description": "类目轴上的 7 × 24 个单元格。默认色阶在 OKLab 中插值并跟随主题：浅色模式从近白色过渡到深主色，深色模式从接近背景的色调过渡到明亮的主色；色例显示其范围。yCategories 按从下到上的顺序列出行，因此星期需要倒序。"
        },
        "color-scale": {
          "title": "发散色阶",
          "description": "colorScale 按数值从低到高列出颜色，并支持 CSS 变量，因此中间色可随主题变化。对称的 valueRange 让 0 始终位于色阶中央。"
        },
        "large-grid": {
          "title": "20,000 个单元格",
          "description": "两个轴均为数字的 200 × 100 网格。interaction={{ zoom: \"xy\" }} 开启缩放（热力图默认关闭）：Ctrl / ⌘ + 滚轮缩放，拖动平移，双击重置。"
        },
        "activity": {
          "title": "贡献日历",
          "description": "像 GitHub 个人主页那样展示一年的每日贡献：以数字表示的周为列，星期为行，x 轴格式把周序号转换为所在月份，palette={[\"var(--success-color)\"]} 生成在浅色和深色主题下都清晰的绿色色阶。"
        },
        "correlation": {
          "title": "相关系数矩阵",
          "description": "使用 colorScale=\"diverging\" 展示产品指标两两之间的相关系数：低于 colorMidpoint（0）为危险色，高于为主色，中间为随主题变化的中性色；两个轴使用同一组翻译后的名称。"
        },
        "retention": {
          "title": "同期群留存",
          "description": "每个月注册用户群在 N 个月后仍活跃的比例：null 值让未来的单元格留空，形成经典的三角形。"
        },
        "conversion": {
          "title": "点击单元格",
          "description": "按流量来源和设备划分的转化率。onPointClick 提供 item.index，即被点击单元格在 data 中的索引，据此找回其会话数和订单数显示在读数中；onPlotClick 清除选择。"
        },
        "rack-temperatures": {
          "title": "实时传感器网格",
          "description": "服务器通道中各传感器的进风温度，由 setInterval 刷新，暂停和卸载时清除。固定的 valueRange 让每次刷新时相同温度保持相同颜色，colorScale 使用主题颜色从冷到热过渡。"
        },
        "confusion-matrix": {
          "title": "混淆矩阵",
          "description": "图像分类器的预测结果，每个单元格按其在实际类别中的占比着色。renderTooltip 通过 item.index 找到悬停的单元格，显示数量，并在对角线上显示召回率和精确率。"
        },
        "sales-regions": {
          "title": "切换指标",
