      "entry": "example.ts",
      "files": {
        "example.ts": "import { Component } from '@angular/core';\nimport { MnHeatmapChart, injectMinerva } from 'minerva-design/angular';\n\n@Component({\n  selector: 'app-example',\n  imports: [MnHeatmapChart],\n  template: `\n@let t = labels[language()];\n<mn-heatmap-chart\n  [data]=\"cells[language()]\"\n  [xCategories]=\"hours\"\n  [yCategories]=\"t.rows\"\n  [name]=\"t.commits\"\n  [height]=\"300\"\n/>\n  `,\n})\nexport class Example {\n  readonly language = injectMinerva().language;\n  hours = [\"0–4\", \"4–8\", \"8–12\", \"12–16\", \"16–20\", \"20–24\"];\n  cells = {\n  \"en\": [\n    {\n      \"x\": \"0–4\",\n      \"y\": \"Mon\",\n      \"value\": 0\n    },\n    {\n      \"x\": \"4–8\",\n      \"y\": \"Mon\",\n      \"value\": 2\n    },\n    {\n      \"x\": \"8–12\",\n      \"y\": \"Mon\",\n      \"value\": 30\n    },\n    {\n      \"x\": \"12–16\",\n      \"y\": \"Mon\",\n      \"value\": 22\n    },\n    {\n      \"x\": \"16–20\",\n      \"y\": \"Mon\",\n      \"value\": 27\n    },\n    {\n      \"x\": \"20–24\",\n      \"y\": \"Mon\",\n      \"value\": 4\n    },\n    {\n      \"x\": \"0–4\",\n      \"y\": \"Tue\",\n      \"value\": 3\n    },\n    {\n      \"x\": \"4–8\",\n      \"y\": \"Tue\",\n      \"value\": 5\n    },\n    {\n      \"x\": \"8–12\",\n      \"y\": \"Tue\",\n      \"value\": 24\n    },\n    {\n      \"x\": \"12–16\",\n      \"y\": \"Tue\",\n      \"value\": 29\n    },\n    {\n      \"x\": \"16–20\",\n      \"y\": \"Tue\",\n      \"value\": 21\n    },\n    {\n      \"x\": \"20–24\",\n      \"y\": \"Tue\",\n      \"value\": 1\n    },\n    {\n      \"x\": \"0–4\",\n      \"y\": \"Wed\",\n      \"value\": 0\n    },\n    {\n      \"x\": \"4–8\",\n      \"y\": \"Wed\",\n      \"value\": 2\n    },\n    {\n      \"x\": \"8–12\",\n      \"y\": \"Wed\",\n      \"value\": 31\n    },\n    {\n      \"x\": \"12–16\",\n      \"y\": \"Wed\",\n      \"value\": 23\n    },\n    {\n      \"x\": \"16–20\",\n      \"y\": \"Wed\",\n      \"value\": 28\n    },\