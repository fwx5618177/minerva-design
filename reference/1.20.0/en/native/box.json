    "translationResources": {
      "title": "Box",
      "description": "A polymorphic container with spacing, size, background, radius and shadow shorthands.",
      "demos": {
        "basic": {
          "title": "Basic usage",
          "description": "Numeric spacing selects tokens (4 -> var(--space-4)); bg accepts surface aliases."
        },
        "sizing": {
          "title": "Sizing and centering",
          "description": "Size props take pixels or CSS lengths; mx=\"auto\" centers a bounded box."
        },
        "polymorphic": {
          "title": "Polymorphic element",
          "description": "Use as to render semantic elements such as ul / li or section."
        }
      },
      "api": {
        "BoxProps": {
          "ref": "Ref to the rendered element",
          "as": "Element or component to render",
          "p": "All-sides padding (spacing token or CSS value)",
          "px": "Horizontal padding (spacing token or CSS value)",
          "py": "Vertical padding (spacing token or CSS value)",
          "pt": "Top padding (spacing token or CSS value)",
          "pr": "Right padding (spacing token or CSS value)",
          "pb": "Bottom padding (spacing token or CSS value)",
          "pl": "Left padding (spacing token or CSS value)",
          "m": "All-sides margin (spacing token or CSS value such as \"auto\")",
          "mx": "Horizontal margin (spacing token or CSS value such as \"auto\")",
          "my": "Vertical margin (spacing token or CSS value such as \"auto\")",
          "mt": "Top margin (spacing token or CSS value such as \"auto\")",
          "mr": "Right margin (spacing token or CSS value such as \"auto\")",
          "mb": "Bottom margin (spacing token or CSS value such as \"auto\")",
          "ml": "Left margin (spacing token or CSS value such as \"auto\")",
          "w": "Width: numbers are pixels, strings are CSS lengths",
          "h": "Height: numbers are pixels, strings are CSS lengths",
          "minW": "Minimum width",
          "minH": "Minimum height",
          "maxW": "Maximum width",
          "maxH": "Maximum height",
          "bg": "Background: a surface alias (bg, bg.subtle, bg.muted, bg.canvas, bg.elevated, bg.emphasis) or any CSS background",
          "rounded": "Border radius: a radius token (none, sm, md, lg, xl, 2xl, full) or any CSS value",
          "boxShadow": "Box shadow: a shadow token (sm, md, lg, xl) or any CSS value",
          "border": "CSS border shorthand, used as-is"
        }
      },
      "wc": {
        "demos": {
          "basic": {
            "title": "Basic usage",
            "description": "The element itself is the box: p, bg, rounded, box-shadow and border are applied to the host."
          },
          "spacing-sizing": {
            "title": "Spacing and sizing",
            "description": "Numbers select spacing tokens (p=\"4\" is var(--space-4)), other strings are CSS values; sizes (w, h, min-/max-) are pixels or CSS lengths. Side attributes win over axis ones, which win over the all-sides shorthand."
          },
          "surfaces": {
            "title": "Surfaces, radius and shadow",
            "description": "bg accepts the surface aliases (bg, bg.subtle, bg.muted, bg.canvas, bg.elevated) or any CSS background; rounded and box-shadow accept tokens or CSS values."
          }
        },
        "minerva-box": {
          "slots": {
