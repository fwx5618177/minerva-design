  "examples": [
    {
      "id": "basic",
      "kind": "internal-demo",
      "entry": "apps/docs/src/docs/pages/page-tabs/native/basic.tsx",
      "files": {
        "apps/docs/src/docs/pages/page-tabs/native/basic.tsx": "import { useState } from \"react\";\nimport { Text, View } from \"react-native\";\nimport { PageTabs, PageTab } from \"minerva-design/native\";\nexport default function Basic() {\n  const [active, setActive] = useState(\"overview\");\n  return (\n    <View>\n      <PageTabs activeValue={active}>\n        <PageTab\n          value=\"overview\"\n          label=\"Overview\"\n          onSelect={() => setActive(\"overview\")}\n        />\n        <PageTab\n          value=\"settings\"\n          label=\"Settings\"\n          onSelect={() => setActive(\"settings\")}\n        />\n      </PageTabs>\n      <Text>{active}</Text>\n    </View>\n  );\n}\n"
      },
      "dependencies": [
        "minerva-design",
        "react",
        "react-native"
      ],
      "contextImports": [],
      "title": "基础用法",
      "description": "每个 PageTab 包含一个标签按钮（激活时为 aria-current=\"page\"）和可选的独立操作，例如关闭按钮。关闭获得焦点的条目时，焦点会移到当前页面。"
    }
  ],
