    "translationResources": {
      "title": "Radio 单选框",
      "description": "用于在一组选项中选择唯一的一项。使用 RadioGroup 统一管理多个单选框的选中状态。",
      "demos": {
        "basic": {
          "title": "基础用法",
          "description": "默认选中 Apple；选择 Banana 或 Cherry 后替换当前选项。"
        },
        "controlled": {
          "title": "受控模式",
          "description": "默认选择 Pro，切换套餐后同步更新下方结果。"
        },
        "horizontal": {
          "title": "水平排列",
          "description": "默认垂直排列，设置 direction=\"horizontal\" 改为水平排列。"
        },
        "sizes": {
          "title": "尺寸",
          "description": "提供 small、medium（默认）和 large 三种尺寸，RadioGroup 的 size 会作用于所有子项。"
        },
        "colors": {
          "title": "颜色",
          "description": "color 设置单选框的语义色：primary（默认）、success、warning 或 danger。RadioGroup 的 color 作用于组内所有单选框，并覆盖它们自身的颜色。"
        },
        "disabled": {
          "title": "禁用",
          "description": "点击已禁用的 Sold out 不会改变 Available；禁用组始终保留 Option A。"
        },
        "validation": {
          "title": "校验与辅助文字",
          "description": "RadioGroup 支持 required、error 和 helperText；单独的 Radio 可显示 errorMessage（带 errorIcon）或 helperText。"
        }
      },
      "api": {
        "RadioProps": {
          "checked": "是否选中（受控），在 RadioGroup 内无效",
          "defaultChecked": "初始选中状态（非受控），在 RadioGroup 内无效",
          "disabled": "是否禁用",
          "name": "原生 name 属性，在 RadioGroup 内使用分组的 name",
          "value": "单选框的值，用于在 RadioGroup 中标识该项",
          "onChange": "选中状态变化时的回调（仅独立使用时有效，分组内请使用 RadioGroup 的 onChange）",
          "size": "尺寸，会被 RadioGroup 的 size 覆盖",
          "label": "显示在单选框旁的文字标签",
          "aria-label": "无障碍标签；没有可见标签时必填",
          "className": "额外的类名",
          "color": "选中时单选框的语义色。若 RadioGroup 设置了 color，则会被其覆盖",
          "required": "标记为必填",
          "error": "显示错误状态（errorMessage 替换 helperText）",
          "errorIcon": "错误信息前显示的图标",
          "errorMessage": "error 为 true 时显示在单选框下方的消息（通过 aria-describedby 关联）",
          "helperText": "显示在单选框下方的帮助文本（通过 aria-describedby 关联）",
          "ref": "指向原生 <input type=\"radio\"> 元素的 ref",
          "children": "标签内容（label 的替代写法；未设置 label 时使用）",
          "aria-labelledby": "为单选框提供标签的元素 id（可多个）",
