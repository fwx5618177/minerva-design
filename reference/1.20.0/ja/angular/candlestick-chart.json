      "id": "ohlc",
      "title": "Daily candles",
      "description": "",
      "kind": "internal-demo",
      "entry": "example.ts",
      "files": {
        "example.ts": "import { Component } from '@angular/core';\nimport { MnCandlestickChart, injectMinerva } from 'minerva-design/angular';\n\n@Component({\n  selector: 'app-example',\n  imports: [MnCandlestickChart],\n  template: `\n@let t = labels[language()];\n<mn-candlestick-chart\n  [series]=\"[{ name: t.price, data: candles }]\"\n  [xAxis]=\"{ title: t.day }\"\n  [yAxis]=\"{ zero: false }\"\n  [height]=\"300\"\n/>\n  `,\n})\nexport class Example {\n  readonly language = injectMinerva().language;\n  candles = [\n  {\n    \"x\": 1,\n    \"open\": 100,\n    \"y\": 100,\n    \"high\": 101.5,\n    \"low\": 98.5\n  },\n  {\n    \"x\": 2,\n    \"open\": 101.98,\n    \"y\": 105.76,\n    \"high\": 107.26,\n    \"low\": 100.48\n  },\n  {\n    \"x\": 3,\n    \"open\": 103.84,\n    \"y\": 101.39,\n    \"high\": 105.34,\n    \"low\": 99.89\n  },\n  {\n    \"x\": 4,\n    \"open\": 105.45,\n    \"y\": 103.25,\n    \"high\": 106.95,\n    \"low\": 101.75\n  },\n  {\n    \"x\": 5,\n    \"open\": 106.73,\n    \"y\": 110.6,\n    \"high\": 112.1,\n    \"low\": 105.23\n  },\n  {\n    \"x\": 6,\n    \"open\": 107.59,\n    \"y\": 107.29,\n    \"high\": 109.09,\n    \"low\": 105.79\n  },\n  {\n    \"x\": 7,\n    \"open\": 107.98,\n    \"y\": 104.3,\n    \"high\": 109.48,\n    \"low\": 102.8\n  },\n  {\n    \"x\": 8,\n    \"open\": 107.87,\n    \"y\": 110.55,\n    \"high\": 112.05,\n    \"low\": 106.37\n  },\n  {\n    \"x\": 9,\n    \"open\": 107.27,\n    \"y\": 109.22,\n    \"high\": 110.72,\n    \"low\": 105.77\n  },\n  {\n    \"x\": 10,\n    \"open\": 106.22,\n    \"y\": 102.29,\n    \"high\": 107.72,\n    \"low\": 100.79\n  },\n  {\n    \"x\": 11,\n    \"open\": 104.79,\n    \"y\": 105.39,\n    \"high\": 106.89,\n    \"low\": 103.29\n  },\n  {\n    \"x\": 12,\n    \"open\": 103.05,\n    \"y\": 106.6,\n    \"high\": 108.1,\n    \"low\": 101.55\n  },\n  {\n    \"x\": 13,\n    \"open\": 101.13,\n    \"y\": 98.23,\n    \"high\": 102.63,\n    \"low\": 96.73\n  },\n  {\n    \"x\": 14,