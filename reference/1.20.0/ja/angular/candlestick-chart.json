    {
      "id": "moving-average",
      "title": "移動平均",
      "description": "type: \"line\" の系列はローソク足の上に描かれます。ここでは 5 日・20 日移動平均で、期間がそろうまでは null です。日にちにホバーすると OHLC、騰落率、両方の平均値を確認できます。",
      "kind": "internal-demo",
      "entry": "example.ts",
      "files": {
        "example.ts": "import { Component } from '@angular/core';\nimport { MnCandlestickChart, injectMinerva } from 'minerva-design/angular';\n\n@Component({\n  selector: 'app-example',\n  imports: [MnCandlestickChart],\n  template: `\n@let t = labels[language()];\n<mn-candlestick-chart\n  [series]=\"[\n    { name: t.price, data: candles },\n    { name: t.average, type: 'line', curve: 'smooth', data: average }\n  ]\"\n  [yAxis]=\"{ zero: false }\"\n  [height]=\"300\"\n/>\n  `,\n})\nexport class Example {\n  readonly language = injectMinerva().language;\n  candles = [\n  {\n    \"x\": 1,\n    \"open\": 80,\n    \"y\": 80,\n    \"high\": 81.5,\n    \"low\": 78.5\n  },\n  {\n    \"x\": 2,\n    \"open\": 82.78,\n    \"y\": 86.56,\n    \"high\": 88.06,\n    \"low\": 81.28\n  },\n  {\n    \"x\": 3,\n    \"open\": 85.44,\n    \"y\": 82.99,\n    \"high\": 86.94,\n    \"low\": 81.49\n  },\n  {\n    \"x\": 4,\n    \"open\": 87.85,\n    \"y\": 85.65,\n    \"high\": 89.35,\n    \"low\": 84.15\n  },\n  {\n    \"x\": 5,\n    \"open\": 89.93,\n    \"y\": 93.8,\n    \"high\": 95.3,\n    \"low\": 88.43\n  },\n  {\n    \"x\": 6,\n    \"open\": 91.59,\n    \"y\": 91.29,\n    \"high\": 93.09,\n    \"low\": 89.79\n  },\n  {\n    \"x\": 7,\n    \"open\": 92.78,\n    \"y\": 89.1,\n    \"high\": 94.28,\n    \"low\": 87.6\n  },\n  {\n    \"x\": 8,\n    \"open\": 93.47,\n    \"y\": 96.15,\n    \"high\": 97.65,\n    \"low\": 91.97\n  },\n  {\n    \"x\": 9,\n    \"open\": 93.67,\n    \"y\": 95.62,\n    \"high\": 97.12,\n    \"low\": 92.17\n  },\n  {\n    \"x\": 10,\n    \"open\": 93.42,\n    \"y\": 89.49,\n    \"high\": 94.92,\n    \"low\": 87.99\n  },\n  {\n    \"x\": 11,\n    \"open\": 92.79,\n    \"y\": 93.39,\n    \"high\": 94.89,\n    \"low\": 91.29\n  },\n  {\n    \"x\": 12,\n    \"open\": 91.85,\n    \"y\": 95.4,\n    \"high\": 96.9,\n    \"low\": 90.35\n  },\n  {\n    \"x\": 13,\n    \"open\": 90.73,\n    \"y\": 87.83,\n    \"high\": 92.23,\n    \"low\": 86.33\n  },\n  {\n    \"x\": 14,\n    \"open\": 89.53,\n    \"y\": 87.86,\n    \"high\": 91.03,\n    \"low\": 86.36\n  },\n  {\n    \"x\": 15,\n    \"open\": 88.39,\n    \"y\": 92.37,\n    \"high\": 93.87,\n    \"low\": 86.89\n  },\n  {\n    \"x\": 16,\n    \"open\": 87.43,\n    \"y\": 86.53,\n    \"high\": 88.93,\n    \"low\": 85.03\n  },\n  {\n    \"x\": 17,\n    \"open\": 86.75,\n    \"y\": 83.35,\n    \"high\": 88.25,\n    \"low\": 81.85\n  },\n  {\n    \"x\": 18,\n    \"open\": 86.44,\n    \"y\": 89.53,\n    \"high\": 91.03,\n    \"low\": 84.94\n  },\n  {\n    \"x\": 19,\n    \"open\": 86.58,\n    \"y\": 87.98,\n    \"high\": 89.48,\n    \"low\": 85.08\n  },\n  {\n    \"x\": 20,\n    \"open\": 87.21,\n    \"y\": 83.21,\n    \"high\": 88.71,\n    \"low\": 81.71\n  },\n  {\n    \"x\": 21,\n    \"open\": 88.33,\n    \"y\": 89.51,\n    \"high\": 91.01,\n    \"low\": 86.83\n  },\n  {\n    \"x\": 22,\n    \"open\": 89.93,\n    \"y\": 93.16,\n    \"high\": 94.66,\n    \"low\": 88.43\n  },\n  {\n    \"x\": 23,\n    \"open\": 91.96,\n    \"y\": 88.68,\n    \"high\": 93.46,\n    \"low\": 87.18\n  },\n  {\n    \"x\": 24,\n    \"open\": 94.33,\n    \"y\": 93.22,\n    \"high\": 95.83,\n    \"low\": 91.72\n  }\n];\n  average = [\n  {\n    \"x\": 1,\n    \"y\": 80\n  },\n  {\n    \"x\": 2,\n    \"y\": 83.28\n  },\n  {\n    \"x\": 3,\n    \"y\": 83.18\n  },\n  {\n    \"x\": 4,\n    \"y\": 83.8\n  },\n  {\n    \"x\": 5,\n    \"y\": 85.8\n  },\n  {\n    \"x\": 6,\n    \"y\": 88.06\n  },\n  {\n    \"x\": 7,\n    \"y\": 88.57\n  },\n  {\n    \"x\": 8,\n    \"y\": 91.2\n  },\n  {\n    \"x\": 9,\n    \"y\": 93.19\n  },\n  {\n    \"x\": 10,\n    \"y\": 92.33\n  },\n  {\n    \"x\": 11,\n    \"y\": 92.75\n  },\n  {\n    \"x\": 12,\n    \"y\": 94.01\n  },\n  {\n    \"x\": 13,\n    \"y\": 92.35\n  },\n  {\n    \"x\": 14,\n    \"y\": 90.79\n  },\n  {\n    \"x\": 15,\n    \"y\": 91.37\n  },\n  {\n    \"x\": 16,\n    \"y\": 90\n  },\n  {\n    \"x\": 17,\n    \"y\": 87.59\n  },\n  {\n    \"x\": 18,\n    \"y\": 87.93\n  }