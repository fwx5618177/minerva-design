        "apps/docs/src/docs/pages/popover/native/basic.tsx": "import { Text } from \"react-native\";\nimport {\n  Popover,\n  PopoverTrigger,\n  PopoverContent,\n  PopoverClose,\n  Button,\n} from \"minerva-design/native\";\nexport default function Basic() {\n  return (\n    <Popover>\n      <PopoverTrigger asChild>\n        <Button>Details</Button>\n      </PopoverTrigger>\n      <PopoverContent title=\"Account\">\n        <Text>Signed in as Ada.</Text>\n        <PopoverClose asChild>\n          <Button>Done</Button>\n        </PopoverClose>\n      </PopoverContent>\n    </Popover>\n  );\n}\n"
      },
