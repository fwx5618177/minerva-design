  "examples": [
    {
      "id": "basic",
      "kind": "internal-demo",
      "entry": "apps/docs/src/docs/pages/virtual-list/native/basic.tsx",
      "files": {
        "apps/docs/src/docs/pages/virtual-list/native/basic.tsx": "import { useState } from \"react\";\nimport { Text, View } from \"react-native\";\nimport { VirtualList } from \"minerva-design/native\";\nexport default function Basic() {\n  const [selected, setSelected] = useState(-1);\n  const items = Array.from({ length: 1000 }, (_, id) => ({ id }));\n  return (\n    <View>\n      <Text>Selected row: {selected}</Text>\n      <VirtualList\n        items={items}\n        itemHeight={44}\n        maxHeight={260}\n        onItemClick={(_, index) => setSelected(index)}\n        renderItem={(item) => <Text>Record {item.id}</Text>}\n      />\n    </View>\n  );\n}\n"
      },
      "dependencies": [
        "minerva-design",
        "react",
        "react-native"
      ],
      "contextImports": [],
      "title": "基础用法",
      "description": "10,000 行数据，固定 itemHeight；DOM 中只存在可见行（以及 overscan 预渲染的行）。"
    }
  ],
