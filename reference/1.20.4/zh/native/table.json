  "documentationContext": {
    "translationResources": {
      "title": "Table 表格",
      "description": "展示数据行。常规场景用 Table（columns + data），自定义表头或合并单元格用 TableRoot 及其子组件，需要分页、加载与错误状态时用 DataTable。",
      "demos": {
        "basic": {
          "title": "基础用法",
          "description": "每列默认读取 row[key]，也可提供 render 函数。请为行提供稳定的 rowKey。"
        },
        "variants": {
          "title": "变体与尺寸",
          "description": "普通、斑马纹或带边框的行，三种密度（small / medium / large），可选悬停高亮。"
        },
        "fixed-columns": {
          "title": "固定列与滚动",
          "description": "scroll.x 设置最小宽度，scroll.y 限制高度并固定表头。固定列必须设置 width，并连续声明在开头（left）或末尾（right）；ellipsis 截断长文本。 当固定列的实测总宽度使滚动区域不足 120px 时，组件自动取消固定，所有字段和操作仍可通过横向滚动访问。"
