    "translationResources": {
      "title": "MonthCalendar 月历",
      "description": "周一开始的月历网格，显示每日日程数量，支持键盘导航并列出选中日期的日程。",
      "demos": {
        "basic": {
          "title": "基本用法",
          "description": "选择日期以列出其日程；方向键、Home / End 与 PageUp / PageDown（按住 Shift 为一年）移动焦点。每一天都是带 aria-selected 的可聚焦网格单元格，选中状态只播报一次。"
        },
        "sizes": {
          "title": "尺寸",
          "description": "size=\"small\" 为紧凑网格，日程以圆点表示；size=\"large\" 为宽松布局，单元格更高，日期数字在顶部，日程数量徽标在底部。"
        },
        "range": {
          "title": "高亮范围",
          "description": "rangeStart / rangeEnd 为区间内的日期着色并填充两端（仅展示，顺序不限）。此示例中第一次点击开始新范围，第二次点击结束范围。"
        }
      },
