  "examples": [
    {
      "id": "basic",
      "kind": "internal-demo",
      "entry": "apps/docs/src/docs/pages/box/demos/basic.tsx",
      "files": {
        "apps/docs/src/docs/pages/box/demos/basic.tsx": "import { Box } from \"minerva-design\";\n\nexport default function BasicDemo() {\n  return (\n    <Box\n      p={4}\n      bg=\"bg.subtle\"\n      rounded=\"md\"\n      border=\"1px solid var(--border-color)\"\n    >\n      Padding token 4, subtle surface, medium radius.\n    </Box>\n  );\n}\n"
      },
      "dependencies": [
        "minerva-design"
      ],
      "contextImports": [],
      "title": "基本的な使い方",
      "description": "数値の間隔はトークンを選択します（4 -> var(--space-4)）。bg はサーフェスの別名を受け付けます。"
    },
    {
      "id": "polymorphic",
      "kind": "internal-demo",
      "entry": "apps/docs/src/docs/pages/box/demos/polymorphic.tsx",
      "files": {
        "apps/docs/src/docs/pages/box/demos/polymorphic.tsx": "import { Box } from \"minerva-design\";\n\nexport default function PolymorphicDemo() {\n  return (\n    <Box as=\"ul\" m={0} pl={5} mt={2}>\n      <Box as=\"li\" mb={1}>\n        Rendered as a list item\n      </Box>\n      <Box as=\"li\">Spacing props still apply</Box>\n    </Box>\n  );\n}\n"
      },
      "dependencies": [
        "minerva-design"
      ],
      "contextImports": [],
      "title": "ポリモーフィック要素",
      "description": "as を使って ul / li や section などのセマンティックな要素を描画します。"
    },
    {
      "id": "sizing",
      "kind": "internal-demo",
      "entry": "apps/docs/src/docs/pages/box/demos/sizing.tsx",
      "files": {
        "apps/docs/src/docs/pages/box/demos/sizing.tsx": "import { Box } from \"minerva-design\";\n\nexport default function SizingDemo() {\n  return (\n    <Box as=\"section\" aria-label=\"Centered\" w=\"100%\" py={6} bg=\"bg.muted\">\n      <Box maxW={360} mx=\"auto\" p={4} bg=\"bg\" rounded=\"lg\" boxShadow=\"md\">\n        maxW=360 with mx=&quot;auto&quot; centers the card.\n      </Box>\n    </Box>\n  );\n}\n"
      },
      "dependencies": [
        "minerva-design"
      ],
      "contextImports": [],
      "title": "サイズと中央寄せ",
      "description": "サイズ props はピクセルまたは CSS の長さを受け付けます。mx=\"auto\" で幅を制限したボックスを中央に配置します。"
    }
  ],
