  "examples": [
    {
      "id": "basic",
      "kind": "internal-demo",
      "entry": "apps/docs/src/docs/pages/page/native/basic.tsx",
      "files": {
        "apps/docs/src/docs/pages/page/native/basic.tsx": "import {\n  Page,\n  PageHeader,\n  PageSection,\n  StatCard,\n  Toolbar,\n  Button,\n} from \"minerva-design/native\";\nexport default function Basic() {\n  return (\n    <Page>\n      <PageHeader title=\"Workspace\" description=\"Your project overview\" />\n      <PageSection title=\"Activity\">\n        <StatCard label=\"Projects\" value={12} />\n      </PageSection>\n      <Toolbar>\n        <Button>New project</Button>\n      </Toolbar>\n    </Page>\n  );\n}\n"
      },
      "dependencies": [
        "minerva-design"
      ],
      "contextImports": [],
      "title": "Page, en-tête et sections",
      "description": "PageHeader rend le h1 avec des actions ; chaque PageSection est une région nommée par son h2."
    }
