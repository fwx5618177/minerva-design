  "documentationContext": {
    "translationResources": {
      "title": "漏斗图",
      "description": "展示流程中逐级流失的各个阶段（注册、销售管道、结账），并显示每一阶段到下一阶段的转化率。悬停或使用方向键高亮阶段；点击图例项可将其隐藏。",
      "demos": {
        "basic": {
          "title": "基础",
          "description": "梯形逐级收窄并显示转化率；renderTooltip 用 React 补充访客占比和流失人数。"
        },
        "bars": {
          "title": "条形与排序",
          "description": "shape=\"bar\" 为非顺序流程的数值绘制居中条形；sort 对其排序（带动画），conversion={false} 隐藏转化率。"
        },
        "ecommerce": {
          "title": "电商结账",
          "description": "网店的结账漏斗，旁边的 Table 列出各阶段之间的流失率；流失最多的阶段在两处都以红色突出显示。"
        },
        "recruiting": {
          "title": "招聘流程",
          "description": "某个岗位从投递到录用的候选人，以条形显示，每个阶段一种颜色；提示框补充该阶段的典型耗时，点击可选中阶段。"
        },
        "compare": {
          "title": "分群对比",
          "description": "按设备拆分的同一漏斗并排显示，阶段相同、每个分群一种颜色，便于看出移动端用户在哪里流失。"
        },
        "campaigns": {
          "title": "按渠道划分的营销漏斗",
          "description": "通过 Select 将漏斗筛选为单个获客渠道，各阶段以动画过渡到新的数量。renderTooltip 根据该渠道的花费补充相对上一阶段的转化率和单次结果成本；下方文字给出获客成本。"
        },
        "what-if": {
          "title": "转化假设模型",
          "description": "−1 / +1 按钮调整某个结账步骤的转化率，漏斗会根据访问量重新计算；摘要将订单数和收入与当前转化率下的结果对比。转化率以整数百分点保存，这样“重置”才能准确判断是否有变化。"
        },
        "live-sale": {
          "title": "实时限时抢购",
          "description": "以 30 次刷新回放一小时的抢购（setInterval，在暂停、结束和卸载时清除）：新访客不断到来，并借助带种子的随机数生成器逐级向下流动。状态行随时钟更新，只播报抢购结束。"
        },
        "sales-pipeline": {
          "title": "B2B 销售管道",
          "description": "各阶段按其未结商机的金额确定大小，由于每个阶段包含不同的商机，设置 conversion={false}。onClick 在漏斗旁列出该阶段的商机，renderTooltip 显示商机数量和赢单概率。"
        }
      },
