    "translationResources": {
      "title": "Drawer 抽屉",
      "description": "从视口边缘滑出的面板，用于筛选、详情等次要任务。行为与模态框一致：锁定焦点、Escape、点击遮罩关闭并归还焦点。",
      "demos": {
        "basic": {
          "title": "基础用法",
          "description": "通过 open 和 onOpenChange 受控，包含主体和操作底栏。"
        },
        "sides": {
          "title": "方向与尺寸",
          "description": "side 选择滑出的边缘；size 设置宽度（左 / 右）或高度（上 / 下）。"
        },
        "compound": {
          "title": "组合式 API",
          "description": "DrawerRoot、DrawerTrigger、DrawerContent、DrawerHeader、DrawerBody、DrawerFooter 和 DrawerClose。"
        }
      },
      "api": {
        "DrawerProps": {
          "open": "受控的打开状态；不传（undefined）时为非受控",
          "defaultOpen": "非受控时的初始打开状态",
          "onOpenChange": "请求改变打开状态时调用（触发器、关闭按钮、Escape、点击遮罩）",
          "trigger": "点击后打开的元素（单个元素，以 asChild 方式渲染）",
          "side": "面板滑出的边缘",
          "size": "尺寸预设：左右方向为宽度，上下方向为高度",
          "title": "标题，作为对话框的可访问名称",
          "description": "标题下方的描述，作为可访问描述",
          "hideCloseButton": "隐藏关闭（×）按钮",
          "closeLabel": "关闭按钮的可访问标签；默认为本地化的“关闭”",
          "hiddenDescription": "未设置 description 时使用的视觉隐藏描述文字；默认为本地化的“抽屉内容”",
          "className": "面板的额外类名",
          "ref": "指向对话框元素的 ref",
          "children": "内容：通常是 DrawerBody + DrawerFooter"
        },
        "DrawerRootProps": {
          "open": "受控的打开状态；不传（undefined）时为非受控",
          "defaultOpen": "非受控时的初始打开状态",
