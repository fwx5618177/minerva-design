  "examples": [
    {
      "id": "side-panel",
      "title": "Side panel",
      "description": "",
      "kind": "internal-demo",
      "entry": "example.ts",
      "files": {
        "example.ts": "import { Component } from '@angular/core';\nimport { MnButton, MnDrawer, MnDrawerBody, MnDrawerFooter } from 'minerva-design/angular';\n\n@Component({\n  selector: 'app-example',\n  imports: [MnButton, MnDrawer, MnDrawerBody, MnDrawerFooter],\n  template: `\n<button mnButton (click)=\"open=true\">Open details</button><mn-drawer title=\"Project details\" description=\"Review the latest information\" [(open)]=\"open\"><mn-drawer-body>Updated today by your team.</mn-drawer-body><mn-drawer-footer><button mnButton (click)=\"open=false\">Done</button></mn-drawer-footer></mn-drawer>\n  `,\n})\nexport class Example {\n  open = false;\n}\n"
      },
      "dependencies": [
        "@angular/core",
        "minerva-design"
      ],
      "contextImports": []
    },
    {
      "id": "bottom-sheet",
      "title": "Bottom sheet",
      "description": "",
      "kind": "internal-demo",
      "entry": "example.ts",
      "files": {
        "example.ts": "import { Component } from '@angular/core';\nimport { MnButton, MnDrawer } from 'minerva-design/angular';\n\n@Component({\n  selector: 'app-example',\n  imports: [MnButton, MnDrawer],\n  template: `\n<button mnButton variant=\"outline\" (click)=\"open=true\">Open bottom sheet</button><mn-drawer title=\"Quick actions\" side=\"bottom\" [(open)]=\"open\">Choose an action.</mn-drawer>\n  `,\n})\nexport class Example {\n  open = false;\n}\n"
      },
      "dependencies": [
        "@angular/core",
