  "examples": [
    {
      "id": "basic",
      "kind": "internal-demo",
      "entry": "apps/docs/src/docs/pages/nav-tree/native/basic.tsx",
      "files": {
        "apps/docs/src/docs/pages/nav-tree/native/basic.tsx": "import { useState } from \"react\";\nimport { NavTree } from \"minerva-design/native\";\nexport default function Basic() {\n  const [active, setActive] = useState(\"overview\");\n  return (\n    <NavTree\n      activeId={active}\n      onItemSelect={(item) => setActive(item.id)}\n      sections={[\n        {\n          id: \"workspace\",\n          title: \"Workspace\",\n          items: [\n            {\n              id: \"pages\",\n              label: \"Pages\",\n              children: [\n                { id: \"overview\", label: \"Overview\" },\n                { id: \"settings\", label: \"Settings\" },\n              ],\n            },\n          ],\n        },\n      ]}\n    />\n  );\n}\n"
      },
      "dependencies": [
        "minerva-design",
        "react"
      ],
