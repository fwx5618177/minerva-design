    {
      "id": "basic",
      "kind": "internal-demo",
      "entry": "apps/docs/src/docs/pages/page/vue/basic.vue",
      "files": {
        "apps/docs/src/docs/pages/page/vue/basic.vue": "<script setup lang=\"ts\">\nimport { Page, PageHeader, PageSection } from \"minerva-design/vue\";\n</script>\n<template>\n  <Page max-width=\"900px\"\n    ><PageHeader\n      title=\"Projects\"\n      description=\"Manage your team’s work\"\n    /><PageSection title=\"Recent activity\"\n      ><p>No updates today.</p></PageSection\n    ></Page\n  >\n</template>\n"
      },
      "dependencies": [
        "minerva-design"
      ],
      "contextImports": [],
      "title": "basic",
      "description": ""
    },
    {
      "id": "stat-cards",
      "kind": "internal-demo",
      "entry": "apps/docs/src/docs/pages/page/vue/stat-cards.vue",
      "files": {
        "apps/docs/src/docs/pages/page/vue/stat-cards.vue": "<script setup lang=\"ts\">\nimport { ResponsiveGrid, StatCard } from \"minerva-design/vue\";\n</script>\n<template>\n  <ResponsiveGrid :columns=\"{ base: 1, sm: 3 }\" :gap=\"4\"\n    ><StatCard\n      label=\"Revenue\"\n      value=\"$24,560\"\n      description=\"+12% this month\" /><StatCard\n      label=\"Customers\"\n      :value=\"1280\"\n      description=\"84 new customers\" /><StatCard\n      label=\"Availability\"\n      value=\"99.9%\"\n      description=\"Last 30 days\"\n  /></ResponsiveGrid>\n</template>\n"
      },
      "dependencies": [
        "minerva-design"
      ],
      "contextImports": [],
      "title": "stat-cards",
      "description": ""
    },
    {
      "id": "toolbar",
      "kind": "internal-demo",
      "entry": "apps/docs/src/docs/pages/page/vue/toolbar.vue",
      "files": {
        "apps/docs/src/docs/pages/page/vue/toolbar.vue": "<script setup lang=\"ts\">\nimport { ref } from \"vue\";\nimport {\n  Page,\n  PageHeader,\n  PageSection,\n  Toolbar,\n  Button,\n  Input,\n} from \"minerva-design/vue\";\nconst query = ref(\"\");\nconst invited = ref(0);\n</script>\n<template>\n  <Page\n    ><PageHeader title=\"Members\"\n      ><template #actions\n        ><Button @click=\"invited++\">Invite member</Button></template\n      ></PageHeader\n    ><Toolbar wrap\n      ><Input\n        v-model=\"query\"\n        aria-label=\"Search members\"\n        placeholder=\"Search members\"\n      /><output\n        >{{ invited }} invitations · {{ query || \"All members\" }}</output\n      ></Toolbar\n    ><PageSection title=\"Directory\"\n      ><p>Search and manage your members.</p></PageSection\n    ></Page\n  >\n</template>\n"
      },
      "dependencies": [
        "minerva-design",
        "vue"
      ],
      "contextImports": [],
      "title": "toolbar",
      "description": ""
    }
