      "id": "pipeline",
      "kind": "internal-demo",
      "entry": "apps/docs/src/docs/pages/dependency-graph/vue/pipeline.vue",
      "files": {
        "apps/docs/src/docs/pages/dependency-graph/vue/pipeline.vue": "<script setup lang=\"ts\">\n// A CI pipeline left to right: the duration of a job is its value, so the\n// critical path (the longest chain of jobs) is highlighted and can be\n// switched off.\nimport { computed, ref } from \"vue\";\nimport { Switch, useI18n } from \"minerva-design/vue\";\nimport { DependencyGraph } from \"minerva-design/vue/charts\";\n\nconst TEXT = {\n  en: {\n    jobs: [\n      \"Install dependencies\",\n      \"Lint\",\n      \"Type check\",\n      \"Unit tests\",\n      \"Build\",\n      \"E2E tests\",\n      \"Package\",\n      \"Deploy\",\n    ],\n    minutes: \"{n} min\",\n    critical: \"Critical path\",\n  },\n  zh: {\n    jobs: [\n      \"安装依赖\",\n      \"代码检查\",\n      \"类型检查\",\n      \"单元测试\",\n      \"构建\",\n      \"端到端测试\",\n      \"打包\",\n      \"部署\",\n    ],\n    minutes: \"{n} 分钟\",\n    critical: \"关键路径\",\n  },\n  ja: {\n    jobs: [\n      \"依存関係のインストール\",\n      \"Lint\",\n      \"型チェック\",\n      \"単体テスト\",\n      \"ビルド\",\n      \"E2E テスト\",\n      \"パッケージ化\",\n      \"デプロイ\",\n    ],\n    minutes: \"{n} 分\",\n    critical: \"クリティカルパス\",\n  },\n  fr: {\n    jobs: [\n      \"Installer les dépendances\",\n      \"Analyse statique\",\n      \"Vérification des types\",\n      \"Tests unitaires\",\n      \"Compilation\",\n      \"Tests E2E\",\n      \"Empaquetage\",\n      \"Déploiement\",\n    ],\n    minutes: \"{n} min\",\n    critical: \"Chemin critique\",\n  },\n};\n// duration of each job of TEXT.jobs, in minutes\nconst MINUTES = [3, 2, 3, 6, 5, 9, 2, 4];\n// job → the jobs that need it (indexes in TEXT.jobs)\nconst NEEDS = [\n  [0, 1],\n  [0, 2],\n  [0, 3],\n  [2, 4],\n  [4, 5],\n  [1, 6],\n  [3, 6],\n  [4, 6],\n  [6, 7],\n  [5, 7],\n];\n\nconst { language } = useI18n();\nconst text = computed(() => TEXT[language.value] ?? TEXT.en);\nconst nodes = computed(() =>\n  text.value.jobs.map((label, i) => ({\n    id: `j${i}`,\n    label,\n    subtitle: text.value.minutes.replace(\"{n}\", String(MINUTES[i])),\n    value: MINUTES[i],\n  })),\n);\nconst edges = NEEDS.map(([a, b]) => ({ source: `j${a}`, target: `j${b}` }));\nconst critical = ref(true);\n</script>\n\n<template>\n  <div style=\"display: grid; gap: 12px; width: 100%\">\n    <Switch v-model=\"critical\" :label=\"text.critical\" />\n    <DependencyGraph\n      :nodes=\"nodes\"\n      :edges=\"edges\"\n      direction=\"LR\"\n      edge-style=\"orthogonal\"\n      :critical-path=\"critical\"\n      :height=\"380\"\n    />\n  </div>\n</template>\n"
      },
      "dependencies": [
        "minerva-design",
        "vue"
      ],
      "contextImports": [],
      "title": "pipeline",
      "description": ""
    }
