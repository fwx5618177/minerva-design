      "entry": "apps/docs/src/docs/pages/dependency-graph/vue/modules.vue",
      "files": {
        "apps/docs/src/docs/pages/dependency-graph/vue/modules.vue": "<script setup lang=\"ts\">\n// Modules of a web application, from the shared code at the top to the\n// application at the bottom: hovering or clicking a module highlights its\n// whole lineage (what it needs and what needs it).\nimport { computed, ref } from \"vue\";\nimport { useI18n } from \"minerva-design/vue\";\nimport { DependencyGraph } from \"minerva-design/vue/charts\";\n\nconst TEXT = {\n  en: {\n    modules: [\n      \"Utilities\",\n      \"HTTP\",\n      \"Translations\",\n      \"UI components\",\n      \"Charts\",\n      \"API client\",\n      \"Authentication\",\n      \"State store\",\n      \"Router\",\n      \"Dashboard\",\n      \"Reports\",\n      \"Application\",\n    ],\n    layers: [\"Shared\", \"Core\", \"Features\", \"Application\"],\n    hint: \"Click a module to highlight its dependencies\",\n    selected: \"Selected: \",\n  },\n  zh: {\n    modules: [\n      \"工具函数\",\n      \"HTTP\",\n      \"多语言\",\n      \"UI 组件\",\n      \"图表\",\n      \"API 客户端\",\n      \"认证\",\n      \"状态管理\",\n      \"路由\",\n      \"仪表盘\",\n      \"报表\",\n      \"应用\",\n    ],\n    layers: [\"共享\", \"核心\", \"功能\", \"应用\"],\n    hint: \"点击一个模块以高亮其依赖\",\n    selected: \"已选择：\",\n  },\n  ja: {\n    modules: [\n      \"ユーティリティ\",\n      \"HTTP\",\n      \"翻訳\",\n      \"UI コンポーネント\",\n      \"チャート\",\n      \"API クライアント\",\n      \"認証\",\n      \"状態管理\",\n      \"ルーター\",\n      \"ダッシュボード\",\n      \"レポート\",\n      \"アプリ\",\n    ],\n    layers: [\"共有\", \"コア\", \"機能\", \"アプリ\"],\n    hint: \"モジュールをクリックすると依存関係が強調表示されます\",\n    selected: \"選択中: \",\n  },\n  fr: {\n    modules: [\n      \"Utilitaires\",\n      \"HTTP\",\n      \"Traductions\",\n      \"Composants UI\",\n      \"Graphiques\",\n      \"Client API\",\n      \"Authentification\",\n      \"Gestion d'état\",\n      \"Routeur\",\n      \"Tableau de bord\",\n      \"Rapports\",\n      \"Application\",\n    ],\n    layers: [\"Partagé\", \"Cœur\", \"Fonctionnalités\", \"Application\"],\n    hint: \"Cliquez sur un module pour mettre en évidence ses dépendances\",\n    selected: \"Sélection : \",\n  },\n};\n// layer (index in TEXT.layers) of each module of TEXT.modules\nconst LAYER = [0, 1, 0, 0, 0, 1, 1, 1, 1, 2, 2, 3];\n// dependency → dependent (indexes in TEXT.modules)\nconst USES = [\n  [0, 1],\n  [1, 5],\n  [5, 6],\n  [5, 7],\n  [6, 8],\n  [0, 4],\n  [2, 3],\n  [3, 9],\n  [3, 10],\n  [4, 9],\n  [4, 10],\n  [5, 9],\n  [5, 10],\n  [7, 9],\n  [7, 10],\n  [8, 11],\n  [9, 11],\n  [10, 11],\n  [6, 11],\n  [2, 11],\n];\n\nconst { language } = useI18n();\nconst text = computed(() => TEXT[language.value] ?? TEXT.en);\nconst nodes = computed(() =>\n  text.value.modules.map((label, i) => ({\n    id: `m${i}`,\n    label,\n    group: `l${LAYER[i]}`,\n  })),\n);\nconst groups = computed(() =>\n  text.value.layers.map((name, i) => ({ id: `l${i}`, name })),\n);\nconst edges = USES.map(([a, b]) => ({ source: `m${a}`, target: `m${b}` }));\nconst selection = ref<string[]>([]);\nconst status = computed(() =>\n  selection.value.length\n    ? text.value.selected +\n      selection.value\n        .map((id) => text.value.modules[Number(id.slice(1))])\n        .join(\", \")\n    : text.value.hint,\n);\n</script>\n\n<template>\n  <div style=\"display: grid; gap: 8px; width: 100%\">\n    <DependencyGraph\n      :nodes=\"nodes\"\n      :edges=\"edges\"\n      :groups=\"groups\"\n      highlight=\"lineage\"\n      :height=\"460\"\n      @selection-change=\"selection = $event\"\n    />\n    <output aria-live=\"polite\">{{ status }}</output>\n  </div>\n</template>\n"
      },
      "dependencies": [
