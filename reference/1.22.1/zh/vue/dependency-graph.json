    "translationResources": {
      "title": "依赖图",
      "description": "以分层方式绘制的有向无环图：包依赖、构建流水线、数据血缘、任务计划。Sugiyama 布局会打破环、分配层级、为跨层的边插入虚拟节点、减少交叉并让长边保持笔直；边可以是平滑样条或带箭头的正交连线。悬停或选中节点即可高亮其全部上游和下游，还能显示计划的关键路径。",
      "intro": {
        "overview": {
          "title": "布局原理",
          "text": "DependencyGraph 即 layout=\"dag\" 的 GraphChart：方框按标签自适应大小，每条边带箭头，并高亮上下游。同一布局也以纯函数 dagLayout 导出。",
          "layers": "通过反转深度优先搜索中的回边来打破环；层级由最长路径确定，随后把源节点移到其后继旁边，并把出入边数相等的节点移到较空的层。",
          "crossings": "跨越多层的边会插入虚拟节点；再通过重心法和中位数法的多轮上下扫描重排每一层并保留最佳顺序，最后用相邻交换消除剩余交叉。",
          "coordinates": "层内位置由朝向邻居的加权保序回归求得，长边权重很高，因此保持笔直。支持 TB、LR、BT 和 RL 四个方向。",
          "highlight": "highlight=\"lineage\"（此处的默认值）会高亮悬停、聚焦或选中节点的全部祖先和后代；criticalPath 高亮总时长（节点 value）最长的链路。"
        }
      },
      "demos": {
        "packages": {
          "title": "包依赖",
          "description": "单体仓库中的包，从应用一直到设计令牌和工具链。开发依赖以虚线表示；悬停某个包可查看它依赖的全部包以及依赖它的全部包。utils 与 i18n 互相依赖：循环依赖以红色的两条独立路线绘制。"
        },
        "pipeline": {
          "title": "CI/CD 流水线",
          "description": "从左到右的构建流水线，使用正交连线。分组按状态为任务着色（可在图例中隐藏），节点 value 为耗时，criticalPath 高亮最长的任务链，下方摘要用 criticalPath() 重新计算。构建应用到打包之间传递两个产物（平行边各走各的路线），失败的视觉测试会重试自身（自环）。"
        },
        "lineage": {
          "title": "上游与下游",
          "description": "从原始表到看板的数据血缘。选中状态会保持血缘高亮：点击模型查看它的来源和去向，按 Esc 或点击背景清除。"
        },
        "build-scheduler": {
          "title": "构建调度器",
          "description": "任务调度器用 1、2 或 4 个 worker 执行 monorepo 构建，优先启动剩余链路最长的就绪任务。随着计时推进，分组把任务标为已完成、运行中或排队中；节点 value 为耗时，criticalPath 显示无论多少 worker 都无法突破的构建时长下限。"
        },
        "project-plan": {
          "title": "项目计划",
          "description": "用关键路径法排定网站上线计划：最早与最晚开始时间得出每个任务的浮动时间，零浮动的链路以 id 列表传给 criticalPath。副标题用 Intl.DateTimeFormat.formatRange 显示工作日区间；点击任务查看其日期与浮动时间。"
        },
        "impact-analysis": {
