      "title": "Popover",
      "description": "A click-triggered floating panel for interactive content such as filters or account menus, anchored to its trigger. Unlike Tooltip it holds focusable content and manages focus, Escape and outside clicks itself; inside a Modal it closes first.",
      "demos": {
        "basic": {
          "title": "Basic usage",
          "description": "PopoverTrigger toggles the panel; focus moves inside and returns to the trigger on close. PopoverClose closes it. In a non-modal popover, Tab past the last element (Shift+Tab before the first) closes it and moves focus to the element after (before) the trigger; focus never loops inside."
        },
        "placement": {
          "title": "Placement",
          "description": "side, align and sideOffset position the panel; it flips and shifts to stay in view. arrow points at the trigger."
        },
        "controlled": {
          "title": "Controlled with an anchor",
          "description": "open + onOpenChange control the state; PopoverAnchor positions the panel against another element."
        }
      },
      "api": {
        "PopoverProps": {
          "open": "Controlled open state; leave undefined for uncontrolled",
          "defaultOpen": "Initial open state while uncontrolled",
          "onOpenChange": "Called with the requested open state (trigger, Escape, outside click, PopoverClose)",
          "modal": "Modal mode: traps focus (Tab loops inside the panel), locks page scrolling, hides the rest of the page from assistive technology and blocks outside pointer interaction (an outside click still closes it)",
          "children": "PopoverTrigger / PopoverAnchor and PopoverContent"
        },
        "PopoverContentProps": {
          "ref": "Ref to the panel element",
          "side": "Preferred side; flips when there is not enough room",
          "align": "Alignment along the trigger",
          "sideOffset": "Gap to the trigger in pixels",
          "arrow": "Renders an arrow pointing at the trigger",
          "portal": "Renders the panel into a portal (the theme-scoped container of a nested ConfigProvider, else document.body)",
          "alignOffset": "Skid along the trigger in pixels (positive = towards the end)",
          "collisionPadding": "Minimum distance to the viewport edges in pixels; currently fixed at 8px, other values are reserved",
          "matchAnchorWidth": "Sizes the panel after the trigger / anchor width: \"min\" at least as wide, \"exact\" exactly as wide",
          "forceMount": "Keeps the panel mounted while closed (data-state=\"closed\"), e.g. for animation libraries",
          "onOpenAutoFocus": "Called before focus moves into the panel on open; event.preventDefault() keeps focus where it is",
