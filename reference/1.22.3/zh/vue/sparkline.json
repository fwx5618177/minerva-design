      "demos": {
        "basic": {
          "title": "基础",
          "description": "同一组数据分别绘制为平滑折线、面积和柱；reference 在指定值处画一条虚线，例如平均值或目标值。"
        },
        "kpi-cards": {
          "title": "KPI 卡片",
          "description": "放在 Card 中、位于指标数值及其变化下方的迷你图：趋势为数字提供了上下文。每张卡片选用与指标相符的类型和颜色。"
        },
        "table": {
          "title": "表格中",
          "description": "在 Table 的一列中为每行放置一个固定宽高的 Sparkline；颜色表示延迟是上升还是下降。"
        },
        "watchlist": {
          "title": "自选股列表",
          "description": "类似交易应用的自选股：每行一条日内面积迷你图，颜色取决于当日涨跌，虚线表示昨收价；价格使用 Intl.NumberFormat 和各股票的币种。"
        },
        "inline": {
          "title": "嵌入句子",
          "description": "迷你图以固定宽高和 display: inline-block 嵌入文字中，这正是迷你图最初的用法。"
