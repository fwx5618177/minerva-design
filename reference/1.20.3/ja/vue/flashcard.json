  "examples": [
    {
      "id": "axis-variants",
      "kind": "internal-demo",
      "entry": "apps/docs/src/docs/pages/flashcard/vue/axis-variants.vue",
      "files": {
        "apps/docs/src/docs/pages/flashcard/vue/axis-variants.vue": "<script setup lang=\"ts\">\nimport { Flashcard } from \"minerva-design/vue\";\n</script>\n<template>\n  <div\n    style=\"\n      display: grid;\n      gap: 16px;\n      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));\n    \"\n  >\n    <Flashcard\n      variant=\"elevated\"\n      front=\"elevated · axis y\"\n      back=\"Flips horizontally\"\n      :min-height=\"140\"\n    />\n    <Flashcard\n      variant=\"outline\"\n      axis=\"x\"\n      front=\"outline · axis x\"\n      back=\"Flips vertically\"\n      :min-height=\"140\"\n    />\n    <Flashcard\n      variant=\"filled\"\n      size=\"small\"\n      front=\"filled · small\"\n      back=\"Less padding, smaller type\"\n      :min-height=\"140\"\n    />\n    <Flashcard\n      size=\"large\"\n      front=\"large\"\n      back=\"The card grows to fit the taller face: this answer is much longer than the question, and the card height follows it on both sides.\"\n      :min-height=\"140\"\n    />\n  </div>\n</template>\n"
      },
      "dependencies": [
        "minerva-design"
      ],
      "contextImports": [],
      "title": "axis-variants",
      "description": ""
    },
    {
      "id": "basic",
      "kind": "internal-demo",
      "entry": "apps/docs/src/docs/pages/flashcard/vue/basic.vue",
      "files": {
        "apps/docs/src/docs/pages/flashcard/vue/basic.vue": "<script setup lang=\"ts\">\nimport { Flashcard } from \"minerva-design/vue\";\n</script>\n<template>\n  <div style=\"max-width: 420px\">\n    <Flashcard\n      front=\"What is the capital of Australia?\"\n      back=\"Canberra\"\n      show-hint\n    />\n  </div>\n</template>\n"
      },
      "dependencies": [
        "minerva-design"
      ],
      "contextImports": [],
      "title": "basic",
      "description": ""
    },
    {
      "id": "controlled",
      "kind": "internal-demo",
      "entry": "apps/docs/src/docs/pages/flashcard/vue/controlled.vue",
      "files": {
        "apps/docs/src/docs/pages/flashcard/vue/controlled.vue": "<script setup lang=\"ts\">\nimport { computed, ref } from \"vue\";\nimport { Button, Flashcard, VStack } from \"minerva-design/vue\";\nconst deck = [\n  { front: \"ephemeral\", back: \"Lasting for a very short time\" },\n  { front: \"ubiquitous\", back: \"Present, appearing or found everywhere\" },\n  { front: \"laconic\", back: \"Using very few words\" },\n];\nconst ratings = [\"Again\", \"Hard\", \"Good\", \"Easy\"];\nconst index = ref(0);\nconst flipped = ref(false);\nconst log = ref<string[]>([]);\nconst card = computed(() => deck[index.value]!);\nfunction rate(rating: string) {\n  log.value = [...log.value, `${card.value.front}: ${rating}`].slice(-3);\n  flipped.value = false;\n  index.value = (index.value + 1) % deck.length;\n}\n</script>\n<template>\n  <VStack :gap=\"3\" align=\"stretch\" style=\"max-width: 420px\">\n    <Flashcard\n      v-model:flipped=\"flipped\"\n      :front-label=\"`Card ${index + 1} / ${deck.length}`\"\n      back-label=\"Definition\"\n      :back=\"card.back\"\n    >\n      <template #front\n        ><strong style=\"font-size: 1.5rem\">{{ card.front }}</strong></template\n      >\n      <template #footer>\n        <template v-if=\"flipped\">\n          <Button\n            v-for=\"rating in ratings\"\n            :key=\"rating\"\n            size=\"small\"\n            :variant=\"rating === 'Good' ? 'solid' : 'outline'\"\n            @click=\"rate(rating)\"\n            >{{ rating }}</Button\n          >\n        </template>\n        <Button v-else size=\"small\" @click=\"flipped = true\">Show answer</Button>\n      </template>\n    </Flashcard>\n    <output style=\"font-size: 13px\">{{\n      log.length ? log.join(\" · \") : \"Flip the card, then rate it.\"\n    }}</output>\n  </VStack>\n</template>\n"
      },
      "dependencies": [
        "minerva-design",
        "vue"
      ],
      "contextImports": [],
      "title": "controlled",
      "description": ""
    },
    {
      "id": "reduced-disabled",
      "kind": "internal-demo",
      "entry": "apps/docs/src/docs/pages/flashcard/vue/reduced-disabled.vue",
      "files": {
        "apps/docs/src/docs/pages/flashcard/vue/reduced-disabled.vue": "<script setup lang=\"ts\">\nimport { ref } from \"vue\";\nimport { Button, Flashcard } from \"minerva-design/vue\";\nconst flipped = ref(false);\n</script>\n<template>\n  <div\n    style=\"\n      display: grid;\n      gap: 16px;\n      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));\n    \"\n  >\n    <Flashcard\n      front=\"Disabled\"\n      back=\"Never shown by a click\"\n      disabled\n      :min-height=\"140\"\n    />\n    <Flashcard\n      front=\"flipOnClick = false\"\n      back=\"Flipped by the button below\"\n      :flip-on-click=\"false\"\n      :flipped=\"flipped\"\n      :front-label=\"null\"\n      :back-label=\"null\"\n      :min-height=\"140\"\n    >\n      <template #footer\n        ><Button size=\"small\" @click=\"flipped = !flipped\">{{\n          flipped ? \"Hide answer\" : \"Reveal answer\"\n        }}</Button></template\n      >\n    </Flashcard>\n  </div>\n</template>\n"
      },
      "dependencies": [
        "minerva-design",
        "vue"
      ],
      "contextImports": [],
      "title": "reduced-disabled",
      "description": ""
    }
  ],
