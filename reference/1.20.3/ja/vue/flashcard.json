    "translationResources": {
      "title": "Flashcard フラッシュカード",
      "description": "問題と解答を裏返して切り替える両面の学習カード。間隔反復の復習に使います。",
      "demos": {
        "basic": {
          "title": "基本的な使い方",
          "description": "カードをクリックするか、カード上で Enter / Space を押すと 3D 回転で裏返ります。カードはトグルボタン（aria-pressed）で、隠れている面は inert、裏面は polite のライブリージョンなので、表示された解答が読み上げられます。"
        },
        "controlled": {
          "title": "評価ボタン付きの制御された復習",
          "description": "flipped / onFlippedChange で表示面を制御します。footer はカードの下に評価ボタンを置きます（裏返りません）。frontLabel / backLabel で既定のキャプション「問題」/「解答」を置き換えます。"
        },
        "axis-variants": {
          "title": "回転軸・バリアント・サイズ",
          "description": "axis=\"x\" で縦方向に裏返ります。variant は Card と同じ（elevated、outline、filled）、size は余白と文字サイズを調整します。両面は同じグリッドセルに重なるため、カードの高さは高い方の面に合わせられます。"
        },
        "reduced-disabled": {
          "title": "無効化とプログラムによる切り替え",
          "description": "disabled は裏返しを止めてカードを薄く表示します。flipOnClick={false} ではカードはボタンではなく、flipped だけが面を切り替えます。prefers-reduced-motion では回転の代わりにクロスフェードします。"
        }
      },
