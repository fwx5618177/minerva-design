  "documentationContext": {
    "translationResources": {
      "title": "气泡图",
      "description": "用点的大小表示第三个数值的散点图：气泡面积与数值成正比。",
      "demos": {
        "countries": {
          "title": "国家对比",
          "description": "人均 GDP 与预期寿命，气泡大小表示人口，颜色区分大洲；valueName 和 format 设置提示框中数值的名称和格式。"
        },
        "log-scale": {
          "title": "对数坐标",
          "description": "人均收入从 900 美元到 14 万美元：xAxis.type: \"log\" 让它们均匀分布（在任何位置 ×10 的距离都相同），刻度位于每个数量级的 1、2、5。默认范围不再取整个数量级，而是对齐到包含数据的最近 1、2、5 × 10^k 边界（500 美元至 20 万美元），xAxis.min / max 可覆盖；标注和提示框使用美元数值，onZoom 报告的可见范围也是美元而不是对数（Ctrl / ⌘ + 滚轮或双指缩放）。"
        },
        "portfolio": {
          "title": "产品组合",
          "description": "各产品的市场份额、市场增长率和收入，两条参考线把图分成四个象限；showLabels 在气泡周围写出名称。"
        },
        "pipeline": {
          "title": "销售管道",
          "description": "在管道中的天数与赢单概率，气泡大小表示金额；onPointClick 接收被点击气泡的数值。"
        },
        "risk-matrix": {
          "title": "风险矩阵",
          "description": "项目风险按可能性和影响程度放在 5 × 5 网格上，气泡大小表示成本敞口；不设边界的 rect 标注为低风险区和高风险区着色，renderTooltip 计算风险分值。"
        },
        "campaigns": {
          "title": "营销活动",
          "description": "营销活动按上线日期（xAxis.type: \"time\"）和广告支出回报率排列，气泡大小表示预算，每个渠道一个系列；line 标注标出盈亏平衡线，点击图例项可切换渠道。"
        },
        "shared-scale": {
          "title": "共享大小比例",
          "description": "两个图表对比两年的门店区域。使用相同的 maxValue 时，相同营收在两个图表中面积相同；不设置时，每个图表按自身的最大值确定气泡大小。"
        },
        "playback": {
          "title": "逐年动画",
          "description": "1990 年至 2025 年的生育率与预期寿命，用 setInterval 逐年播放（暂停和卸载时清除）。固定的坐标轴范围和恒定的 maxValue 让各帧可以比较，text 标注显示年份。"
        }
      },
