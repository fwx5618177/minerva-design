  "examples": [
    {
      "id": "basic",
      "kind": "internal-demo",
      "entry": "apps/docs/src/docs/pages/drawer/vue/basic.vue",
      "files": {
        "apps/docs/src/docs/pages/drawer/vue/basic.vue": "<script setup lang=\"ts\">\nimport { ref } from \"vue\";\nimport { Drawer, DrawerBody, DrawerFooter, Button } from \"minerva-design/vue\";\nconst open = ref(false);\n</script>\n<template>\n  <Button @click=\"open = true\">Open drawer</Button\n  ><Drawer\n    v-model:open=\"open\"\n    title=\"Project details\"\n    description=\"Review your project settings\"\n    ><DrawerBody><p>Everything you need to manage this project.</p></DrawerBody\n    ><DrawerFooter\n      ><Button @click=\"open = false\">Done</Button></DrawerFooter\n    ></Drawer\n  >\n</template>\n"
      },
      "dependencies": [
        "minerva-design",
        "vue"
      ],
      "contextImports": [],
      "title": "basic",
      "description": ""
    },
    {
      "id": "non-modal",
      "kind": "internal-demo",
      "entry": "apps/docs/src/docs/pages/drawer/vue/non-modal.vue",
      "files": {
        "apps/docs/src/docs/pages/drawer/vue/non-modal.vue": "<script setup lang=\"ts\">\nimport {\n  DrawerRoot,\n  DrawerTrigger,\n  DrawerContent,\n  DrawerBody,\n  DrawerClose,\n  Button,\n} from \"minerva-design/vue\";\n</script>\n<template>\n  <DrawerRoot :modal=\"false\"\n    ><DrawerTrigger as-child\n      ><Button variant=\"outline\">Open non-modal panel</Button></DrawerTrigger\n    ><DrawerContent description=\"The rest of the page stays interactive\"\n      ><template #title>Quick reference</template\n      ><DrawerBody\n        ><p>Keep working while this reference stays open.</p>\n        <DrawerClose>Close panel</DrawerClose></DrawerBody\n      ></DrawerContent\n    ></DrawerRoot\n  >\n</template>\n"
      },
      "dependencies": [
        "minerva-design"
      ],
      "contextImports": [],
      "title": "non-modal",
      "description": ""
    },
    {
      "id": "sides",
      "kind": "internal-demo",
      "entry": "apps/docs/src/docs/pages/drawer/vue/sides.vue",
      "files": {
        "apps/docs/src/docs/pages/drawer/vue/sides.vue": "<script setup lang=\"ts\">\nimport { ref } from \"vue\";\nimport { Drawer, DrawerBody, Button, HStack } from \"minerva-design/vue\";\nimport type { DrawerSide } from \"minerva-design/vue\";\nconst sides: DrawerSide[] = [\"left\", \"right\", \"top\", \"bottom\"];\nconst side = ref<DrawerSide>(\"right\");\nconst open = ref(false);\n</script>\n<template>\n  <HStack :gap=\"3\" wrap\n    ><Button\n      v-for=\"edge in sides\"\n      :key=\"edge\"\n      variant=\"outline\"\n      @click=\"\n        side = edge;\n        open = true;\n      \"\n      >{{ edge }}</Button\n    ></HStack\n  ><Drawer\n    v-model:open=\"open\"\n    :side=\"side\"\n    size=\"small\"\n    :title=\"`${side} drawer`\"\n    ><DrawerBody\n      ><p>Choose the edge that fits your workflow.</p></DrawerBody\n    ></Drawer\n  >\n</template>\n"
      },
      "dependencies": [
        "minerva-design",
        "vue"
      ],
      "contextImports": [],
      "title": "sides",
      "description": ""
    }
  ],
