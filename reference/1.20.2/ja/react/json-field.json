  "examples": [
    {
      "id": "basic",
      "kind": "internal-demo",
      "entry": "apps/docs/src/docs/pages/json-field/demos/basic.tsx",
      "files": {
        "apps/docs/src/docs/pages/json-field/demos/basic.tsx": "import { JsonField } from \"minerva-design\";\nimport { useState } from \"react\";\n\nexport default function BasicDemo() {\n  const [text, setText] = useState('{\"title\":\"Draft\",\"tags\":[\"a\",\"b\"]}');\n  return (\n    <JsonField\n      aria-label=\"Response body\"\n      value={text}\n      onChange={setText}\n      rows={6}\n    />\n  );\n}\n"
      },
      "dependencies": [
        "minerva-design",
        "react"
      ],
      "contextImports": [],
      "title": "基本",
      "description": "入力中は構文フィードバックを控え、フォーカス喪失時に確認します。ボタンは有効な JSON を再インデントします。"
    },
    {
      "id": "form-control",
      "kind": "internal-demo",
      "entry": "apps/docs/src/docs/pages/json-field/demos/form-control.tsx",
      "files": {
        "apps/docs/src/docs/pages/json-field/demos/form-control.tsx": "import { FormField, JsonField } from \"minerva-design\";\n\nexport default function FormControlDemo() {\n  return (\n    <FormField\n      label=\"Dictionary\"\n      helperText=\"Public translation dictionary.\"\n      required\n    >\n      <JsonField name=\"dictionary\" defaultValue='{\"hello\":\"world\"}' rows={5} />\n    </FormField>\n  );\n}\n"
      },
      "dependencies": [
        "minerva-design"
      ],
      "contextImports": [],
      "title": "FormField と併用",
      "description": "無効化・読み取り専用・必須の状態はフィールドから継承されます。"
    },
    {
      "id": "indent",
      "kind": "internal-demo",
      "entry": "apps/docs/src/docs/pages/json-field/demos/indent.tsx",
      "files": {
        "apps/docs/src/docs/pages/json-field/demos/indent.tsx": "import { JsonField } from \"minerva-design\";\n\nexport default function IndentDemo() {\n  return (\n    <>\n      <JsonField\n        aria-label=\"Four spaces\"\n        defaultValue='{\"a\":[1,2]}'\n        indent={4}\n        rows={4}\n      />\n      <JsonField\n        aria-label=\"Compact\"\n        defaultValue={'{\\n  \"a\": [1, 2]\\n}'}\n        indent={0}\n        rows={4}\n      />\n      <JsonField\n        aria-label=\"Without toolbar\"\n        defaultValue=\"{\"\n        hideToolbar\n        rows={2}\n      />\n    </>\n  );\n}\n"
      },
      "dependencies": [
        "minerva-design"
      ],
      "contextImports": [],
      "title": "インデントとツールバー",
      "description": "indent は 1 段あたりの空白数（0 で圧縮）、hideToolbar はボタンを除きフィードバックを残します。"
    }
  ],
