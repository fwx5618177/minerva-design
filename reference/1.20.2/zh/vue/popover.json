  "examples": [
    {
      "id": "anchor",
      "kind": "internal-demo",
      "entry": "apps/docs/src/docs/pages/popover/vue/anchor.vue",
      "files": {
        "apps/docs/src/docs/pages/popover/vue/anchor.vue": "<script setup lang=\"ts\">\nimport {\n  Popover,\n  PopoverAnchor,\n  PopoverTrigger,\n  PopoverContent,\n  Input,\n  Button,\n  VStack,\n} from \"minerva-design/vue\";\n</script>\n<template>\n  <Popover\n    ><VStack :gap=\"3\"\n      ><PopoverAnchor\n        ><Input\n          aria-label=\"Search query\"\n          placeholder=\"Search projects\" /></PopoverAnchor\n      ><PopoverTrigger as-child\n        ><Button>Show search help</Button></PopoverTrigger\n      ></VStack\n    ><PopoverContent match-anchor-width=\"exact\"\n      ><p>\n        The panel is positioned against the input, independently of its trigger.\n      </p></PopoverContent\n    ></Popover\n  >\n</template>\n"
      },
      "dependencies": [
        "minerva-design"
      ],
      "contextImports": [],
      "title": "anchor",
      "description": ""
    },
    {
      "id": "basic",
      "kind": "internal-demo",
      "entry": "apps/docs/src/docs/pages/popover/vue/basic.vue",
      "files": {
        "apps/docs/src/docs/pages/popover/vue/basic.vue": "<script setup lang=\"ts\">\nimport {\n  Popover,\n  PopoverTrigger,\n  PopoverContent,\n  PopoverClose,\n  Button,\n} from \"minerva-design/vue\";\n</script>\n<template>\n  <Popover\n    ><PopoverTrigger as-child><Button>Open popover</Button></PopoverTrigger\n    ><PopoverContent\n      ><p>Review the changes before continuing.</p>\n      <PopoverClose as-child\n        ><Button>Got it</Button></PopoverClose\n      ></PopoverContent\n    ></Popover\n  >\n</template>\n"
      },
      "dependencies": [
        "minerva-design"
      ],
      "contextImports": [],
      "title": "basic",
