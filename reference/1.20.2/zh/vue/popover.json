  "documentationContext": {
    "translationResources": {
      "title": "Popover 气泡卡片",
      "description": "点击触发、锚定在触发器上的浮层面板，用于筛选器、账户菜单等可交互内容。与 Tooltip 不同，它可以包含可聚焦内容，并自行管理焦点、Escape 和外部点击；在 Modal 中会先于 Modal 关闭。",
      "demos": {
        "basic": {
          "title": "基础用法",
          "description": "PopoverTrigger 切换面板；焦点移入面板，关闭后回到触发器。PopoverClose 用于关闭。非模态时，在最后一个元素上按 Tab（在第一个元素上按 Shift+Tab）会关闭面板并把焦点移到触发器之后（之前）的元素；焦点不会在面板内循环。"
        },
        "placement": {
          "title": "位置",
          "description": "side、align 和 sideOffset 决定面板位置；空间不足时会翻转并平移以保持可见。arrow 显示指向触发器的箭头。"
        },
        "controlled": {
          "title": "受控与锚点",
          "description": "open + onOpenChange 控制状态；PopoverAnchor 让面板相对另一个元素定位。"
        }
      },
      "api": {
        "PopoverProps": {
          "open": "受控的打开状态；不传（undefined）时为非受控",
          "defaultOpen": "非受控时的初始打开状态",
          "onOpenChange": "请求改变打开状态时调用（触发器、Escape、外部点击、PopoverClose）",
          "modal": "模态模式：锁定焦点（Tab 在面板内循环）、锁定页面滚动、对辅助技术隐藏页面其余部分并阻止外部指针交互（点击外部仍会关闭）",
          "children": "PopoverTrigger / PopoverAnchor 与 PopoverContent"
        },
        "PopoverContentProps": {
          "ref": "指向面板元素的 ref",
          "side": "首选方向；空间不足时翻转",
          "align": "沿触发器的对齐方式",
          "sideOffset": "与触发器的间距（像素）",
          "arrow": "显示指向触发器的箭头",
          "portal": "把面板渲染到 portal 中（嵌套 ConfigProvider 的主题作用域容器，否则为 document.body）",
          "alignOffset": "沿触发器方向的偏移像素（正值朝向末端）",
          "collisionPadding": "与视口边缘的最小距离（像素）；目前固定为 8px，其他取值为保留值",
          "matchAnchorWidth": "按触发器 / 锚点宽度设置面板尺寸：\"min\" 至少同宽，\"exact\" 完全同宽",
          "forceMount": "关闭时仍保持挂载（data-state=\"closed\"），例如配合动画库使用",
          "onOpenAutoFocus": "打开时焦点移入面板之前调用；event.preventDefault() 可让焦点保持原位",
          "onCloseAutoFocus": "关闭时焦点回到打开者之前调用；event.preventDefault() 可跳过",
          "onEscapeKeyDown": "作为最上层时按下 Escape；event.preventDefault() 可保持打开",
          "onPointerDownOutside": "在外部按下指针；event.preventDefault() 可保持打开",
          "onFocusOutside": "焦点移到外部；event.preventDefault() 可保持打开",
          "onInteractOutside": "外部的指针按下或焦点移动；event.preventDefault() 可保持打开"
        },
        "PopoverTriggerProps": {
          "asChild": "把行为合并到唯一的子元素上，而不是渲染自己的元素"
        }
      },
      "cssVars": {
        "--popover-min-width": "面板的最小宽度",
        "--popover-max-width": "面板的最大宽度",
        "--popover-padding": "面板的内边距",
        "--popover-radius": "面板圆角（默认 --radius-lg）",
        "--popover-background": "面板及其箭头的背景",
        "--popover-border-color": "面板及其箭头的边框颜色",
        "--popover-shadow": "面板阴影（默认 --shadow-lg，深色主题为 --shadow-xl）",
        "--popover-z-index": "面板的层级（默认 --z-popover）"
      },
      "wc": {
        "demos": {
          "basic": {
            "title": "基础用法",
            "description": "trigger 插槽切换一个可交互面板；打开时焦点移入，关闭后返回。Escape、点击外部或带 data-popover-close 的元素都会关闭它。"
          },
          "placement": {
            "title": "位置",
            "description": "side 和 align 决定面板相对触发器的位置，side-offset 设置间距，arrow 显示指向箭头；面板会翻转和平移以保持在视口内。"
          },
          "anchor": {
            "title": "锚点与模态",
            "description": "anchor 让面板相对另一个元素（通过 id）定位，任意按钮都可通过 show() 打开它；modal 会锁定焦点并阻止与页面其余部分交互。"
          }
        },
