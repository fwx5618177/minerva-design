          },
          "methods": {
            "show": "打开弹出层。",
            "hide": "关闭弹出层。",
            "toggle": "切换弹出层。"
          }
        }
      },
      "native": {
        "demos": {
          "basic": {
            "title": "原生示例",
            "description": "在手机预览中操作原生组件。"
          }
        },
        "limitations": "触屏设备使用可关闭的原生对话框展示内容；不使用 DOM 浮动坐标和悬停定位。"
      }
    }
