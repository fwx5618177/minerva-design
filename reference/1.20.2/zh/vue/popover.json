    },
    {
      "id": "placement",
      "kind": "internal-demo",
      "entry": "apps/docs/src/docs/pages/popover/vue/placement.vue",
      "files": {
        "apps/docs/src/docs/pages/popover/vue/placement.vue": "<script setup lang=\"ts\">\nimport {\n  Popover,\n  PopoverTrigger,\n  PopoverContent,\n  Button,\n  HStack,\n} from \"minerva-design/vue\";\nconst sides = [\"top\", \"right\", \"bottom\", \"left\"] as const;\n</script>\n<template>\n  <HStack :gap=\"3\" wrap\n    ><Popover v-for=\"side in sides\" :key=\"side\"\n      ><PopoverTrigger as-child\n        ><Button variant=\"outline\">{{ side }}</Button></PopoverTrigger\n      ><PopoverContent :side=\"side\" align=\"start\" arrow\n        >{{ side }} placement</PopoverContent\n      ></Popover\n    ></HStack\n  >\n</template>\n"
      },
      "dependencies": [
        "minerva-design"
