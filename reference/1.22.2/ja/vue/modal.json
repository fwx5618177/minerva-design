    "translationResources": {
      "title": "Modal モーダル",
      "description": "ページを中断して一つの作業に集中させるダイアログです。フォーカスは内部に閉じ込められ、Escape や背景クリックで閉じ、閉じるとフォーカスは開いた要素に戻ります。狭い画面ではボトムシートになります。",
      "demos": {
        "basic": {
          "title": "基本的な使い方",
          "description": "Cancel は削除せずに閉じます。Delete は閉じた後に Record deleted を表示します。"
        },
        "uncontrolled": {
          "title": "トリガー付きの非制御",
          "description": "trigger を渡すとモーダルが自分で状態を管理します。"
        },
        "sizes": {
          "title": "サイズ",
          "description": "small、medium（既定）、large、xlarge、full。"
        },
        "form": {
          "title": "フォーム",
          "description": "Name を編集して Save を押すと Quarterly report の名前が変わり、ボタンにも新しい名前が表示されます。"
        },
        "compound": {
          "title": "コンポーネント API",
          "description": "ModalRoot、ModalTrigger、ModalContent、ModalHeader、ModalBody、ModalFooter、ModalClose で構造を自由に組み立てます。"
