  "documentationContext": {
    "translationResources": {
      "title": "Stack",
      "description": "Flex layout primitives (Stack, HStack, VStack) with token-based gaps, optional separators and attached groups. Children are not wrapped in item elements.",
      "demos": {
        "basic": {
          "title": "Vertical stack",
          "description": "VStack stacks children in a column and stretches them by default."
        },
        "horizontal": {
          "title": "Horizontal stack",
          "description": "HStack centers items on the cross axis; justify distributes them."
        },
        "gap": {
          "title": "Gap",
          "description": "Numbers select spacing tokens (2 = 8px, 4 = 16px, 6 = 24px); other strings are CSS lengths."
        },
        "wrap": {
          "title": "Wrap and semantics",
          "description": "wrap lets items flow onto new lines; as renders a list."
        },
        "separator": {
          "title": "Separator",
          "description": "separator is rendered between items, such as a vertical Divider; empty children get none."
        },
        "attached": {
          "title": "Attached group",
          "description": "attached joins items into one group with shared borders and outer corners only, like a segmented control."
        }
      },
      "api": {
        "StackProps": {
          "ref": "Ref to the rendered element",
          "as": "Element or component to render",
          "direction": "Flex direction",
          "gap": "Gap between items: numbers and numeric strings select spacing tokens, other strings are CSS values. No gap when omitted.",
          "align": "Cross-axis alignment (align-items); unset when omitted",
          "justify": "Main-axis distribution (justify-content); unset when omitted",
          "wrap": "Wraps items onto multiple lines",
          "separator": "Rendered between every two items (not before the first or after the last); empty children get no separator",
          "attached": "Joins the items into one attached group: no gap, shared borders, outer-only corner radii and role=\"group\""
        }
      },
      "cssVars": {
        "--stack-gap": "Space between the children when the gap prop is not set (default: 0)"
      },
      "wc": {
        "demos": {
          "basic": {
            "title": "Basic usage",
            "description": "A column of items with a token-based gap (gap=\"3\" is var(--space-3)). Children are slotted as-is, not wrapped."
          },
          "hstack-vstack": {
            "title": "HStack, VStack and alignment",
            "description": "<minerva-hstack> is a row centered on the cross axis, <minerva-vstack> a stretched column; align, justify and direction (including the reverse directions) fine-tune them."
          },
          "wrap-separator": {
            "title": "Separators and wrapping",
            "description": "separator inserts a text between items, or, set as a JS property, a function returning fresh content per gap (here a vertical divider). wrap lets the items flow onto several lines. Separators use manual slot assignment; in browsers without slot.assign() (Safari < 16.4) the stack falls back to named slots (a slot=\"minerva-stack-item-n\" attribute on each element child while a separator is set), so separators still appear between element children (wrap bare text in an element)."
          },
          "attached": {
            "title": "Attached groups",
            "description": "attached joins the items into one group (no gap, shared borders) exposed as role=\"group\"; name it with aria-label."
          }
        },
        "minerva-stack": {
          "slots": {
            "default": "Items."
          }
        },
        "minerva-hstack": {
          "slots": {
            "default": "Items, laid out in a row."
          }
        },
        "minerva-vstack": {
          "slots": {
            "default": "Items, laid out in a column."
          }
        }
      },
      "native": {
        "demos": {
