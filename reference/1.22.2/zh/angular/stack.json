    {
      "id": "horizontal-and-vertical",
      "title": "Horizontal and vertical",
      "description": "",
      "kind": "internal-demo",
      "entry": "example.ts",
      "files": {
        "example.ts": "import { Component } from '@angular/core';\nimport { MnHStack, MnVStack, MnButton } from 'minerva-design/angular';\n\n@Component({\n  selector: 'app-example',\n  imports: [MnHStack, MnVStack, MnButton],\n  template: `\n<mn-vstack gap=\"4\"><mn-hstack gap=\"2\"><button mnButton>Save</button><button mnButton variant=\"outline\">Cancel</button></mn-hstack><p>Rows and columns share spacing tokens.</p></mn-vstack>\n  `,\n})\nexport class Example {\n\n}\n"
      },
      "dependencies": [
        "@angular/core",
        "minerva-design"
      ],
      "contextImports": []
    },
    {
      "id": "wrapping-layout",
      "title": "Wrapping layout",
      "description": "",
      "kind": "internal-demo",
      "entry": "example.ts",
      "files": {
        "example.ts": "import { Component } from '@angular/core';\nimport { MnStack, MnTag } from 'minerva-design/angular';\n\n@Component({\n  selector: 'app-example',\n  imports: [MnStack, MnTag],\n  template: `\n<mn-stack direction=\"row\" wrap gap=\"2\"><mn-tag label=\"Design\"/><mn-tag label=\"Engineering\"/><mn-tag label=\"Research\"/></mn-stack>\n  `,\n})\nexport class Example {\n\n}\n"
      },
      "dependencies": [
        "@angular/core",
