  "examples": [
    {
      "id": "kpi",
      "kind": "internal-demo",
      "entry": "apps/docs/src/docs/pages/sparkline/vue/kpi.vue",
      "files": {
        "apps/docs/src/docs/pages/sparkline/vue/kpi.vue": "<script setup lang=\"ts\">\n// Word-sized trends (48px high by default) drawn as a line, an area or bars.\nimport { computed } from \"vue\";\nimport { useI18n } from \"minerva-design/vue\";\nimport { Sparkline } from \"minerva-design/vue/charts\";\n\nconst TEXT = {\n  en: { orders: \"Orders\", revenue: \"Revenue\", signups: \"Sign-ups\" },\n  zh: { orders: \"订单\", revenue: \"收入\", signups: \"注册\" },\n  ja: { orders: \"注文\", revenue: \"売上\", signups: \"登録\" },\n  fr: {\n    orders: \"Commandes\",\n    revenue: \"Chiffre d'affaires\",\n    signups: \"Inscriptions\",\n  },\n};\n\nconst { language } = useI18n();\nconst text = computed(() => TEXT[language.value] ?? TEXT.en);\n</script>\n\n<template>\n  <div\n    style=\"\n      display: grid;\n      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));\n      gap: 12px;\n    \"\n  >\n    <div style=\"display: grid; gap: 4px\">\n      <span>{{ text.orders }}</span>\n      <strong>1,284</strong>\n      <Sparkline\n        :data=\"[32, 41, 38, 52, 49, 61, 58, 70, 66, 74]\"\n        :name=\"text.orders\"\n      />\n    </div>\n    <div style=\"display: grid; gap: 4px\">\n      <span>{{ text.revenue }}</span>\n      <strong>€48.2k</strong>\n      <Sparkline\n        type=\"area\"\n        :data=\"[3.1, 3.4, 3.2, 3.9, 4.4, 4.1, 4.6, 4.8, 4.5, 4.9]\"\n        :name=\"text.revenue\"\n      />\n    </div>\n    <div style=\"display: grid; gap: 4px\">\n      <span>{{ text.signups }}</span>\n      <strong>312</strong>\n      <Sparkline\n        type=\"bar\"\n        :data=\"[12, 18, 9, 22, 30, 25, 19, 28, 33, 31]\"\n        :name=\"text.signups\"\n      />\n    </div>\n  </div>\n</template>\n"
      },
      "dependencies": [
        "minerva-design",
        "vue"
      ],
      "contextImports": [],
      "title": "kpi",
      "description": ""
    },
    {
      "id": "reference",
      "kind": "internal-demo",
      "entry": "apps/docs/src/docs/pages/sparkline/vue/reference.vue",
      "files": {
        "apps/docs/src/docs/pages/sparkline/vue/reference.vue": "<script setup lang=\"ts\">\n// `reference` draws a dashed target line; @hover reports the value under the\n// pointer (null when it leaves).\nimport { computed, ref } from \"vue\";\nimport { useI18n } from \"minerva-design/vue\";\nimport { Sparkline, type ChartHoverEvent } from \"minerva-design/vue/charts\";\n\nconst TEXT = {\n  en: {\n    latency: \"p95 latency\",\n    target: \"target 200 ms\",\n    hint: \"Hover the line\",\n  },\n  zh: {\n    latency: \"p95 延迟\",\n    target: \"目标 200 毫秒\",\n    hint: \"将指针悬停在折线上\",\n  },\n  ja: {\n    latency: \"p95 レイテンシ\",\n    target: \"目標 200 ms\",\n    hint: \"線にカーソルを合わせます\",\n  },\n  fr: {\n    latency: \"Latence p95\",\n    target: \"objectif 200 ms\",\n    hint: \"Survolez la courbe\",\n  },\n};\n\nconst data = [182, 175, 190, 214, 230, 205, 188, 176, 169, 181, 196, 172];\nconst { language } = useI18n();\nconst text = computed(() => TEXT[language.value] ?? TEXT.en);\nconst hovered = ref<number | null>(null);\nconst onHover = (event: ChartHoverEvent | null) => {\n  hovered.value = event?.items[0]?.y ?? null;\n};\nconst format = (ms: number) => `${ms} ms`;\n</script>\n\n<template>\n  <div style=\"display: grid; gap: 8px\">\n    <Sparkline\n      :data=\"data\"\n      :reference=\"200\"\n      :name=\"text.latency\"\n      :format=\"format\"\n      :height=\"64\"\n      @hover=\"onHover\"\n    />\n    <output aria-live=\"polite\">{{\n      hovered === null\n        ? text.hint\n        : `${text.latency}: ${hovered} ms (${text.target})`\n    }}</output>\n  </div>\n</template>\n"
      },
      "dependencies": [
        "minerva-design",
        "vue"
      ],
      "contextImports": [],
      "title": "reference",
      "description": ""
    }
  ],
