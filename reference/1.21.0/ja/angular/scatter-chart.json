  "documentationContext": {
    "translationResources": {
      "title": "散布図",
      "description": "2 つの値で配置する点。ポイントごとにサイズ、色、ラベルを指定でき、両軸でズームできます。",
      "demos": {
        "basic": {
          "title": "基本",
          "description": "軸タイトル付きの [x, y] タプルの 2 系列。ツールチップは最も近い点を表示します。"
        },
        "labels": {
          "title": "ラベルとサイズ",
          "description": "ポイントオブジェクトに label と size を持たせます。showLabels は重なりを避けてラベルを描画します。"
        },
        "large-data": {
          "title": "20 万ポイント",
          "description": "型付き配列の列による 2 つのガウス分布クラスター。ヒットテストには空間インデックスを使います。"
        },
        "trend": {
          "title": "相関と傾向線",
          "description": "キャンペーンの点に最小二乗法の傾向線（デモ内で計算した折れ線系列）を重ね、テキスト注釈で R² と傾きを示します。"
        },
        "categories": {
          "title": "カテゴリ",
          "description": "カテゴリごとに 1 系列にすると、各グループが独自の色と切り替え可能な凡例を持ちます。ここでは 3 種のペンギンのフリッパー長と体重です。"
        },
        "outliers": {
          "title": "外れ値",
          "description": "点ごとの色・サイズ・ラベルで、ペイロードに対して想定よりずっと遅いリクエストを示します。想定時間は折れ線系列です。"
        },
        "zoom-controls": {
          "title": "ズーム操作",
          "description": "ボタンは ref を通じて領域にズームします。setView は表示範囲を設定し（onZoom は呼ばれないため、デモでは getView で表示範囲を読み戻します）、resetZoom で全体表示に戻ります。onZoom はホイールやドラッグによるズームを通知し、rect アノテーションで生育適温域を塗ります。"
        },
        "selection": {
          "title": "クリックで選択",
          "description": "onPointClick はクリックした点の系列とインデックスを返します。選択した社員の点は大きくなりラベルが付き、詳細が下に表示されます。空いたプロット領域をクリックすると onPlotClick が呼ばれ、選択を解除します。"
        },
        "players": {
          "title": "カスタムツールチップと領域",
          "description": "renderTooltip はデモのデータから作った React コンテンツでツールチップを置き換えます。リーグ平均は破線の参照線で、境界を一部省いた rect アノテーションが 2 つの隅をプロットの端まで塗ります。"
        },
        "live-stream": {
          "title": "センサーのライブストリーム",
          "description": "400 ms ごとに振動のサンプルを追加し（setInterval は一時停止とアンマウントで解除）、参照線を境に正常系列とアラーム系列に分けます。min と max を固定して、データが流れ込んでも軸が動かないようにしています。"
        },
        "log-log": {
          "title": "両対数軸",
          "description": "xAxis と yAxis に type: \"log\" を指定すると、代謝率のべき乗則（クライバーの法則）が 6 桁にわたって直線になります。近似線は tooltip: false を指定した 2 点の line 系列です。"
        }
      },
