  "examples": [
    {
      "id": "clusters",
      "title": "Two clusters",
      "description": "",
      "kind": "internal-demo",
      "entry": "example.ts",
      "files": {
        "example.ts": "import { Component } from '@angular/core';\nimport { MnScatterChart, injectMinerva } from 'minerva-design/angular';\n\n@Component({\n  selector: 'app-example',\n  imports: [MnScatterChart],\n  template: `\n@let t = labels[language()];\n<mn-scatter-chart\n  [series]=\"[\n    { name: t.teamA, data: teamA },\n    { name: t.teamB, data: teamB }\n  ]\"\n  [xAxis]=\"{ title: t.hours }\"\n  [yAxis]=\"{ title: t.score }\"\n  [height]=\"300\"\n/>\n  `,\n})\nexport class Example {\n  readonly language = injectMinerva().language;\n  teamA = [\n  {\n    \"x\": 17.05,\n    \"y\": 66.86\n  },\n  {\n    \"x\": 11.05,\n    \"y\": 53.86\n  },\n  {\n    \"x\": 8.21,\n    \"y\": 59.23\n  },\n  {\n    \"x\": 17.99,\n    \"y\": 70.85\n  },\n  {\n    \"x\": 7.8,\n    \"y\": 62.49\n  },\n  {\n    \"x\": 11.6,\n    \"y\": 53.03\n  },\n  {\n    \"x\": 16.73,\n    \"y\": 63.83\n  },\n  {\n    \"x\": 6.1,\n    \"y\": 70.5\n  },\n  {\n    \"x\": 15.14,\n    \"y\": 57.98\n  },\n  {\n    \"x\": 13.72,\n    \"y\": 54.53\n  },\n  {\n    \"x\": 6.57,\n    \"y\": 67.94\n  },\n  {\n    \"x\": 17.52,\n    \"y\": 67.94\n  },\n  {\n    \"x\": 10.08,\n    \"y\": 54.53\n  },\n  {\n    \"x\": 9.04,\n    \"y\": 57.99\n  },\n  {\n    \"x\": 17.86,\n    \"y\": 70.51\n  },\n  {\n    \"x\": 7.15,\n    \"y\": 63.82\n  }\n];\n  teamB = [\n  {\n    \"x\": 21.46,\n    \"y\": 74.12\n  },\n  {\n    \"x\": 26.1,\n    \"y\": 87.51\n  },\n  {\n    \"x\": 30.41,\n    \"y\": 83.95\n  },\n  {\n    \"x\": 20.03,\n    \"y\": 71.47\n  },\n  {\n    \"x\": 29.55,\n    \"y\": 78.25\n  },\n  {\n    \"x\": 27.24,\n    \"y\": 88.98\n  },\n  {\n    \"x\": 20.8,\n    \"y\": 79.43\n  },\n  {\n    \"x\": 31.69,\n    \"y\": 71.17\n  },\n  {\n    \"x\": 23.61,\n    \"y\": 82.84\n  },\n  {\n    \"x\": 23.48,\n    \"y\": 88.1\n  },\n  {\n    \"x\": 31.74,\n    \"y\": 75.07\n  },\n  {\n    \"x\": 20.87,\n    \"y\": 73.17\n  },\n  {\n    \"x\": 27.1,\n    \"y\": 86.69\n  },\n  {\n    \"x\": 29.67,\n    \"y\": 85.11\n  },\n  {\n    \"x\": 20.02,\n    \"y\": 71.99\n  },\n  {\n    \"x\": 30.31,\n    \"y\": 76.96\n  }\n];\n  labels = {\n  \"en\": {\n    \"teamA\": \"Team A\",\n    \"teamB\": \"Team B\",\n    \"hours\": \"Hours\",\n    \"score\": \"Score\"\n  },\n  \"zh\": {\n    \"teamA\": \"A 组\",\n    \"teamB\": \"B 组\",\n    \"hours\": \"小时\",\n    \"score\": \"得分\"\n  },\n  \"ja\": {\n    \"teamA\": \"チームA\",\n    \"teamB\": \"チームB\",\n    \"hours\": \"時間\",\n    \"score\": \"スコア\"\n  },\n  \"fr\": {\n    \"teamA\": \"Équipe A\",\n    \"teamB\": \"Équipe B\",\n    \"hours\": \"Heures\",\n    \"score\": \"Score\"\n  }\n};\n}\n"
      },
      "dependencies": [
        "@angular/core",
        "minerva-design"
      ],
      "contextImports": []
    },
    {
      "id": "point-click",
      "title": "Clicked point",
      "description": "",
      "kind": "internal-demo",
      "entry": "example.ts",
      "files": {
        "example.ts": "import { Component } from '@angular/core';\nimport { MnScatterChart, injectMinerva } from 'minerva-design/angular';\n\n@Component({\n  selector: 'app-example',\n  imports: [MnScatterChart],\n  template: `\n@let t = labels[language()];\n<mn-scatter-chart\n  [series]=\"[{ name: t.cities, pointSize: 12, data: [\n    { x: 20.5, y: 31, label: t.names[0] },\n    { x: 10.9, y: 17, label: t.names[1] },\n    { x: 6.8, y: 15, label: t.names[2] },\n    { x: 4.9, y: 15, label: t.names[3] },\n    { x: 4.8, y: 21, label: t.names[4] },\n    { x: 5.2, y: 16, label: t.names[5] }\n  ] }]\"\n  [xAxis]=\"{ title: t.density }\"\n  [yAxis]=\"{ title: t.rent }\"\n  [height]=\"280\"\n  (pointClick)=\"selected = $event.items[0]?.label + ': ' + $event.items[0]?.x + ' · ' + $event.items[0]?.y + ' €/m²'\"\n/>\n<output aria-live=\"polite\">{{ selected || t.hint }}</output>\n  `,\n})\nexport class Example {\n  readonly language = injectMinerva().language;\n  selected = \"\";\n  labels = {\n  \"en\": {\n    \"cities\": \"Cities\",\n    \"density\": \"Density (k/km²)\",\n    \"rent\": \"Rent (€/m²)\",\n    \"hint\": \"Click a city\",\n    \"names\": [\"Paris\", \"Lyon\", \"Lille\", \"Nantes\", \"Nice\", \"Bordeaux\"]\n  },\n  \"zh\": {\n    \"cities\": \"城市\",\n    \"density\": \"人口密度（千人/km²）\",\n    \"rent\": \"租金（欧元/m²）\",\n    \"hint\": \"点击一个城市\",\n    \"names\": [\"巴黎\", \"里昂\", \"里尔\", \"南特\", \"尼斯\", \"波尔多\"]\n  },\n  \"ja\": {\n    \"cities\": \"都市\",\n    \"density\": \"人口密度（千人/km²）\",\n    \"rent\": \"家賃（€/m²）\",\n    \"hint\": \"都市をクリックします\",\n    \"names\": [\"パリ\", \"リヨン\", \"リール\", \"ナント\", \"ニース\", \"ボルドー\"]\n  },\n  \"fr\": {\n    \"cities\": \"Villes\",\n    \"density\": \"Densité (k/km²)\",\n    \"rent\": \"Loyer (€/m²)\",\n    \"hint\": \"Cliquez sur une ville\",\n    \"names\": [\"Paris\", \"Lyon\", \"Lille\", \"Nantes\", \"Nice\", \"Bordeaux\"]\n  }\n};\n}\n"
      },
      "dependencies": [
        "@angular/core",
        "minerva-design"
      ],
      "contextImports": []
    }
  ],
