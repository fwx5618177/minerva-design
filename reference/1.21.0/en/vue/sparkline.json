    "translationResources": {
      "title": "Sparkline",
      "description": "A word-sized chart without axes or legend that shows the shape of a trend next to a number: in KPI cards, table cells or lists. Hover it to read a value.",
      "demos": {
        "basic": {
          "title": "Basic",
          "description": "The same values as a smooth line, an area and bars; reference draws a dashed line at a value such as the average or a target."
        },
        "kpi-cards": {
          "title": "KPI cards",
          "description": "Sparklines in Cards, under the figure and its change: the trend gives context to the number. Each card uses a type and a color that fit its metric."
        },
        "table": {
          "title": "In a table",
          "description": "A Sparkline per row in a Table column, with a fixed width and height; the color says whether the latency rises or falls."
        },
        "watchlist": {
          "title": "Stock watchlist",
          "description": "A trading-app watchlist: each row has an intraday area sparkline colored by the change of the day, with a dashed reference at the previous close; prices use Intl.NumberFormat with each stock's currency."
        },
        "inline": {
          "title": "Inside a sentence",
          "description": "Word-sized sparklines placed inline in text with a fixed width and height and display: inline-block, the original use of sparklines."
        },
        "servers": {
          "title": "Live server monitor",
          "description": "Bar sparklines updated every second with a new CPU sample; the color and the tag turn red above the alert threshold."
        },
        "hover-value": {
          "title": "Hover readout",
          "description": "onHover receives the hovered point (null when the pointer leaves): its index drives the big number and the date above, which fall back to the latest day. tooltip={false} hides the tooltip that the readout replaces."
        },
        "step-goal": {
          "title": "Daily goal",
          "description": "Four weeks of steps as bars, the days reaching the goal colored through the color of their data point; reference draws the goal and renderTooltip shows the date and the share of the goal."
        },
        "weather": {
          "title": "Small multiples",
          "description": "A Sparkline per city in a grid of Cards. Each one is scaled to its own range, so the warmest and coldest months are written above it; renderTooltip names the hovered month and reference marks 0 °C where the city freezes."
        },
        "periods": {
          "title": "Period switcher",
          "description": "A RadioGroup picks the last 7, 30 or 90 days: the total, the change from the previous period and the color are computed from the same values, and reference marks the daily average of the period."
        }
      },
