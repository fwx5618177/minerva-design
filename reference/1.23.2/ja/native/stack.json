  "examples": [
    {
      "id": "basic",
      "kind": "internal-demo",
      "entry": "apps/docs/src/docs/pages/stack/native/basic.tsx",
      "files": {
        "apps/docs/src/docs/pages/stack/native/basic.tsx": "import { Text } from \"react-native\";\nimport { Stack, HStack, VStack, Button } from \"minerva-design/native\";\nexport default function Basic() {\n  return (\n    <VStack gap={4}>\n      <HStack gap={2} wrap>\n        <Button>Save</Button>\n        <Button variant=\"outline\">Cancel</Button>\n      </HStack>\n      <Stack gap={2} separator=\"·\">\n        <Text>Profile</Text>\n        <Text>Preferences</Text>\n      </Stack>\n    </VStack>\n  );\n}\n"
      },
      "dependencies": [
        "minerva-design",
        "react-native"
      ],
      "contextImports": [],
      "title": "縦方向のスタック",
      "description": "VStack は子要素を縦に並べ、既定で引き伸ばします。"
    }
  ],
