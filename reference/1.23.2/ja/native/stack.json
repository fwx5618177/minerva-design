    "translationResources": {
      "title": "Stack スタック",
      "description": "トークンベースの間隔、区切り、連結グループを備えたフレックスレイアウトの基本コンポーネント（Stack、HStack、VStack）。子要素はラッパーで包まれません。",
      "demos": {
        "basic": {
          "title": "縦方向のスタック",
          "description": "VStack は子要素を縦に並べ、既定で引き伸ばします。"
        },
        "horizontal": {
          "title": "横方向のスタック",
          "description": "HStack は交差軸で中央揃えし、justify で配置を分配します。"
        },
        "gap": {
          "title": "間隔",
          "description": "数値は間隔トークンを選びます（2 = 8px、4 = 16px、6 = 24px）。その他の文字列は CSS の長さです。"
        },
        "wrap": {
          "title": "折り返しとセマンティクス",
          "description": "wrap でアイテムを折り返し、as でリストとして描画します。"
        },
        "separator": {
          "title": "区切り",
          "description": "separator は縦の Divider などを項目の間に表示します。空の子要素には付きません。"
        },
        "attached": {
          "title": "連結グループ",
          "description": "attached は項目を 1 つのグループにつなげ、境界線を共有し外側の角だけを丸めます（セグメントコントロールのように）。"
        }
      },
      "api": {
        "StackProps": {
          "ref": "描画される要素への ref",
          "as": "描画する要素またはコンポーネント",
          "direction": "flex の方向",
          "gap": "アイテム間の間隔：数値と数値文字列はスペーシングトークン、その他は CSS 値。省略時は間隔なし。",
          "align": "交差軸の整列（align-items）。省略時は未設定",
          "justify": "主軸の配置（justify-content）。省略時は未設定",
          "wrap": "アイテムを複数行に折り返します",
          "separator": "各項目の間に表示（先頭の前と末尾の後には表示しない）。空の子要素には付きません",
          "attached": "項目を連結した 1 つのグループにします：間隔なし、境界線の共有、外側だけの角丸、role=\"group\""
        }
      },
      "cssVars": {
        "--stack-gap": "gap プロパティ未指定時の子要素の間隔（既定値は 0）"
      },
      "wc": {
        "demos": {
          "basic": {
            "title": "基本的な使い方",
            "description": "トークンベースの間隔（gap=\"3\" は var(--space-3)）で並ぶ列です。子要素はラップされずそのままスロットに入ります。"
          },
          "hstack-vstack": {
            "title": "HStack・VStack と配置",
            "description": "<minerva-hstack> は交差軸で中央揃えの行、<minerva-vstack> は引き伸ばされた列です。align、justify、direction（逆方向を含む）で調整できます。"
          },
          "wrap-separator": {
            "title": "区切りと折り返し",
            "description": "separator はアイテム間にテキストを挿入します。JS プロパティとして設定すると、間隔ごとに新しいコンテンツを返す関数も使えます（ここでは垂直の区切り線）。wrap でアイテムを複数行に折り返します。 区切りは手動スロット割り当てで挿入されます。slot.assign() のないブラウザ（Safari < 16.4）では名前付きスロットにフォールバックし（区切りが設定されている間、各子要素に slot=\"minerva-stack-item-n\" 属性を付与）、要素の子の間に区切りが表示されます（裸のテキストは要素で囲んでください）。"
          },
          "attached": {
            "title": "連結グループ",
            "description": "attached はアイテムを 1 つのグループに連結し（間隔なし、境界線を共有）、role=\"group\" として公開します。aria-label で名前を付けてください。"
          }
        },
        "minerva-stack": {
          "slots": {
            "default": "アイテム。"
          }
        },
        "minerva-hstack": {
          "slots": {
            "default": "行に並ぶアイテム。"
          }
        },
        "minerva-vstack": {
          "slots": {
            "default": "列に並ぶアイテム。"
          }
        }
      },
