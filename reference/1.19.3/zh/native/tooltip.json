      "title": "Tooltip 文字提示",
      "description": "当用户悬停或聚焦某个元素时显示的简短文字提示。靠近视口边缘时会翻转和平移以保持可见。",
      "demos": {
        "basic": {
          "title": "基础用法",
          "description": "包裹一个可聚焦的元素。提示会在悬停和键盘聚焦时显示，按 Escape 即可关闭，即使它是由悬停打开的。"
        },
        "placements": {
          "title": "位置",
          "description": "围绕触发元素的十二种位置。"
        },
        "colors": {
          "title": "颜色",
          "description": "color 选择语义色：neutral（默认）、info、success、warning 或 danger。"
        },
        "variants": {
          "title": "变体",
          "description": "variant 选择视觉样式：solid（默认，实心填充；neutral 为与主题形成对比的反色表面）、subtle（带边框的浅色调表面）或 glass（跟随主题的磨砂表面，颜色只为边框着色）。"
        },
        "shapes": {
          "title": "形状",
          "description": "默认、圆角、方形和气泡形状。"
        },
        "animations": {
          "title": "动画",
          "description": "选择提示出现和消失的动画。"
        },
        "custom-colors": {
          "title": "自定义颜色、箭头和偏移",
          "description": "通过 contentClassName 在提示上设置 --tooltip-bg（支持纯色和 CSS 渐变）与 --tooltip-color 自定义属性；arrow 添加指向触发元素的箭头；offset 设置与触发元素的间距（默认 8px）。"
        },
        "delays": {
          "title": "延迟与禁用",
          "description": "enterDelay 和 leaveDelay 控制悬停时机；disabled 关闭提示。"
        },
        "follow-cursor": {
          "title": "跟随鼠标",
          "description": "开启 followCursor 后，提示会跟随鼠标指针移动。"
        },
        "controlled": {
          "title": "受控与命令式",
          "description": "通过 open 和 onOpenChange 控制可见性（悬停、聚焦和 Escape 仍会请求变化），或调用 TooltipRef 上的 open / close / toggle。"
        },
        "events": {
          "title": "事件",
          "description": "onOpen 和 onClose 会在悬停、聚焦、失焦及按下 Escape 时触发。"
        },
        "as-child": {
          "title": "asChild",
          "description": "asChild 将提示直接挂到子元素上，不额外包裹元素，因此不会破坏 flex 和 grid 布局。contentClassName 用于设置提示的样式。"
        },
        "provider": {
          "title": "TooltipProvider",
          "description": "TooltipProvider 为内部的提示设置默认延迟；在提示之间快速移动时，下一个提示会立即打开。"
        }
      },
