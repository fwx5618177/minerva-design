  "documentationContext": {
    "translationResources": {
      "title": "Stack 堆叠",
      "description": "弹性布局基础组件（Stack、HStack、VStack），支持基于令牌的间距、分隔符和相连组。子元素不会被额外包裹。",
      "demos": {
        "basic": {
          "title": "垂直堆叠",
          "description": "VStack 将子元素纵向排列，默认拉伸填满。"
        },
        "horizontal": {
          "title": "水平堆叠",
          "description": "HStack 在交叉轴上居中对齐；justify 控制主轴分布。"
        },
        "gap": {
          "title": "间距",
          "description": "数字对应间距令牌（2 = 8px，4 = 16px，6 = 24px）；其他字符串作为 CSS 长度。"
        },
        "wrap": {
          "title": "换行与语义",
          "description": "wrap 允许项目换行；as 可渲染为列表。"
        },
        "separator": {
          "title": "分隔符",
          "description": "separator 渲染在相邻项之间，例如竖向 Divider；空子节点不会产生分隔符。"
        },
        "attached": {
          "title": "相连组",
          "description": "attached 将各项合并为一组：共享边框、仅保留外侧圆角，类似分段控件。"
        }
      },
      "api": {
        "StackProps": {
          "ref": "指向渲染元素的 ref",
          "as": "要渲染的元素或组件",
          "direction": "flex 方向",
          "gap": "项目间距：数字和数字字符串对应间距 token，其他字符串为 CSS 值。省略时无间距。",
          "align": "交叉轴对齐（align-items）；省略时不设置",
          "justify": "主轴分布（justify-content）；省略时不设置",
          "wrap": "允许项目换行",
          "separator": "渲染在每两项之间（首项之前与末项之后不渲染）；空子节点不产生分隔符",
          "attached": "将各项合并为相连的一组：无间距、共享边框、仅外侧圆角，并带 role=\"group\""
        }
      },
      "cssVars": {
        "--stack-gap": "未设置 gap 属性时子元素之间的间距（默认 0）"
      },
      "wc": {
        "demos": {
          "basic": {
            "title": "基本用法",
            "description": "以令牌间距排列的一列项目（gap=\"3\" 即 var(--space-3)）。子元素按原样放入插槽，不会被包裹。"
          },
          "hstack-vstack": {
            "title": "HStack、VStack 与对齐",
            "description": "<minerva-hstack> 是交叉轴居中的行，<minerva-vstack> 是拉伸的列；可通过 align、justify 和 direction（包括反向）微调。"
          },
          "wrap-separator": {
            "title": "分隔符与换行",
            "description": "separator 在项目之间插入文本；作为 JS 属性设置时也可以是一个函数，为每个间隙返回新的内容（这里是垂直分割线）。wrap 允许项目换行显示。 分隔符通过手动 slot 分配实现；在不支持 slot.assign() 的浏览器（Safari < 16.4）中，Stack 会退回到具名 slot（设置分隔符期间为每个子元素添加 slot=\"minerva-stack-item-n\" attribute），因此元素子项之间仍会显示分隔符（纯文本子项请包裹在元素中）。"
          },
          "attached": {
            "title": "连接组",
            "description": "attached 将项目连接为一个整体（无间距、共享边框），并暴露为 role=\"group\"；请用 aria-label 为其命名。"
          }
        },
        "minerva-stack": {
          "slots": {
            "default": "项目。"
          }
        },
        "minerva-hstack": {
          "slots": {
            "default": "项目，按行排列。"
          }
        },
        "minerva-vstack": {
          "slots": {
            "default": "项目，按列排列。"
          }
        }
      },
      "native": {
        "demos": {
          "basic": {
            "title": "原生示例",
            "description": "在手机预览中操作原生组件。"
          }
        }
      }
    }
