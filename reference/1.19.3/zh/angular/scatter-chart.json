    "translationResources": {
      "title": "散点图",
      "description": "由两个值定位的点，每个点可设置大小、颜色和标签。两个轴均可缩放。",
      "demos": {
        "basic": {
          "title": "基础",
          "description": "两个 [x, y] 元组系列，带坐标轴标题；提示框显示最近的点。"
        },
        "labels": {
          "title": "标签与大小",
          "description": "点对象携带 label 和 size；showLabels 绘制标签并跳过重叠项。"
        },
        "large-data": {
          "title": "200,000 个点",
          "description": "以类型化数组列表示的两个高斯簇；命中检测使用空间索引。"
        },
        "trend": {
          "title": "相关性与趋势",
          "description": "在各广告活动的散点上叠加最小二乘趋势线（在示例中计算的折线系列），并用文字标注给出 R² 和斜率。"
        },
        "categories": {
          "title": "分类",
          "description": "每个类别一个系列，各组拥有自己的颜色和可切换的图例项；这里是三种企鹅的鳍肢长度与体重。"
        },
        "outliers": {
          "title": "异常值",
          "description": "通过逐点的颜色、大小和标签标出比其负载预期慢得多的请求；预期耗时是一条折线系列。"
        },
        "zoom-controls": {
          "title": "缩放控制",
          "description": "按钮通过 ref 缩放到指定区域：setView 设置可见范围（它不会触发 onZoom，因此示例用 getView 读回视图），resetZoom 恢复显示全部数据。onZoom 报告滚轮和拖动产生的缩放；rect 标注为适宜生长区间着色。"
        },
        "selection": {
          "title": "点击选中",
          "description": "onPointClick 给出被点击圆点的系列和索引：选中的员工圆点变大并显示标签，详细信息显示在下方。点击空白绘图区时调用 onPlotClick，用于清除选择。"
        },
        "players": {
          "title": "自定义提示框与区域",
          "description": "renderTooltip 用基于示例数据构建的 React 内容替换提示框。联盟平均值是虚线参考线，省略部分边界的 rect 标注将两个角落一直着色到绘图区边缘。"
        },
        "live-stream": {
          "title": "实时传感器数据流",
          "description": "每 400 毫秒新增一个振动样本（setInterval 在暂停和卸载时清除），以参考线为界分为正常和告警两个系列；固定的 min 与 max 让坐标轴在数据流入时保持不动。"
        },
        "log-log": {
          "title": "双对数坐标轴",
          "description": "xAxis 和 yAxis 设置 type: \"log\" 后，代谢率的幂律（克莱伯定律）在六个数量级上呈现为一条直线；拟合线是一个两点的 line 系列，并设置 tooltip: false。"
        }
      },
