    "translationResources": {
      "title": "Flashcard 抽认卡",
      "description": "在问题与答案之间翻转的双面学习卡片，适用于间隔重复复习。",
      "demos": {
        "basic": {
          "title": "基础用法",
          "description": "点击卡片，或在卡片上按 Enter / 空格键，即以 3D 旋转翻面。卡片是切换按钮（aria-pressed）；隐藏的一面为 inert，背面是 polite 实时区域，翻开的答案会被读出。"
        },
        "controlled": {
          "title": "受控复习与评分按钮",
          "description": "flipped / onFlippedChange 控制当前面；footer 在卡片下方放置评分按钮（不随卡片翻转）。frontLabel / backLabel 替换默认的“问题” / “答案”标注。"
        },
        "axis-variants": {
          "title": "翻转轴、变体与尺寸",
          "description": "axis=\"x\" 纵向翻转；variant 与 Card 一致（elevated、outline、filled），size 调整内边距与字号。两面位于同一网格单元，卡片高度取较高的一面。"
        },
        "reduced-disabled": {
          "title": "禁用与程序化翻转",
          "description": "disabled 阻止翻转并使卡片变淡；flipOnClick={false} 时卡片不是按钮，只能通过 flipped 翻面。在 prefers-reduced-motion 下两面以淡入淡出切换，不做旋转。"
        }
      },
