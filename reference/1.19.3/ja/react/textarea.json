  "examples": [
    {
      "id": "basic",
      "kind": "internal-demo",
      "entry": "apps/docs/src/docs/pages/textarea/demos/basic.tsx",
      "files": {
        "apps/docs/src/docs/pages/textarea/demos/basic.tsx": "import { Textarea } from \"minerva-design\";\nimport { useState } from \"react\";\n\nexport default function BasicDemo() {\n  const [bio, setBio] = useState(\"\");\n  return (\n    <Textarea\n      aria-label=\"Bio\"\n      rows={4}\n      placeholder=\"Tell us about yourself\"\n      value={bio}\n      onChange={(event) => setBio(event.target.value)}\n    />\n  );\n}\n"
      },
      "dependencies": [
        "minerva-design",
        "react"
      ],
      "contextImports": [],
      "title": "基本",
      "description": "制御されたテキストエリア。ネイティブ属性はそのまま渡されます。"
    },
    {
      "id": "form-control",
      "kind": "internal-demo",
      "entry": "apps/docs/src/docs/pages/textarea/demos/form-control.tsx",
      "files": {
        "apps/docs/src/docs/pages/textarea/demos/form-control.tsx": "import { FormField, Textarea } from \"minerva-design\";\n\nexport default function FormControlDemo() {\n  return (\n    <>\n      <FormField label=\"Summary\" helperText=\"At most 200 characters.\" required>\n        <Textarea rows={3} maxLength={200} />\n      </FormField>\n      <FormField label=\"Notes\" errorMessage=\"Notes are too long.\">\n        <Textarea rows={3} defaultValue=\"Lorem ipsum…\" />\n      </FormField>\n    </>\n  );\n}\n"
      },
      "dependencies": [
        "minerva-design"
      ],
      "contextImports": [],
      "title": "FormField と併用",
      "description": "ラベル・ヘルプ・エラー・必須状態はフィールドから来ます。"
    },
    {
      "id": "sizes-variants",
      "kind": "internal-demo",
      "entry": "apps/docs/src/docs/pages/textarea/demos/sizes-variants.tsx",
      "files": {
        "apps/docs/src/docs/pages/textarea/demos/sizes-variants.tsx": "import { Textarea } from \"minerva-design\";\n\nexport default function SizesVariantsDemo() {\n  return (\n    <>\n      <Textarea aria-label=\"Small\" size=\"small\" placeholder=\"small\" />\n      <Textarea aria-label=\"Large\" size=\"large\" placeholder=\"large\" />\n      <Textarea aria-label=\"Filled\" variant=\"filled\" placeholder=\"filled\" />\n      <Textarea\n        aria-label=\"Unstyled\"\n        variant=\"unstyled\"\n        placeholder=\"unstyled\"\n      />\n    </>\n  );\n}\n"
      },
      "dependencies": [
        "minerva-design"
      ],
      "contextImports": [],
      "title": "サイズとバリアント",
      "description": "サイズはフォントサイズと最小の高さを変えます。"
    }
  ],
