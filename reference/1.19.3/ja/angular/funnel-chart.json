  "examples": [
    {
      "id": "conversion",
      "title": "Conversion funnel",
      "description": "",
      "kind": "internal-demo",
      "entry": "example.ts",
      "files": {
        "example.ts": "import { Component } from '@angular/core';\nimport { MnFunnelChart, injectMinerva } from 'minerva-design/angular';\n\n@Component({\n  selector: 'app-example',\n  imports: [MnFunnelChart],\n  template: `\n@let t = labels[language()];\n<mn-funnel-chart\n  [data]=\"[\n    { name: t[0], value: 12000 },\n    { name: t[1], value: 4800 },\n    { name: t[2], value: 2100 },\n    { name: t[3], value: 860 }\n  ]\"\n  [height]=\"300\"\n/>\n  `,\n})\nexport class Example {\n  readonly language = injectMinerva().language;\n  labels = {\n  \"en\": [\"Visits\", \"Sign-ups\", \"Trials\", \"Purchases\"],\n  \"zh\": [\"访问\", \"注册\", \"试用\", \"购买\"],\n  \"ja\": [\"訪問\", \"登録\", \"トライアル\", \"購入\"],\n  \"fr\": [\"Visites\", \"Inscriptions\", \"Essais\", \"Achats\"]\n};\n}\n"
      },
      "dependencies": [
        "@angular/core",
        "minerva-design"
      ],
      "contextImports": []
    },
    {
      "id": "bars",
      "title": "バーと並べ替え",
      "description": "shape=\"bar\" は順序のない値を中央揃えのバーで描きます。sort で並べ替え（アニメーション付き）、conversion={false} で率を非表示にします。",
      "kind": "internal-demo",
      "entry": "example.ts",
      "files": {
        "example.ts": "import { Component } from '@angular/core';\nimport { MnFunnelChart, injectMinerva } from 'minerva-design/angular';\n\n@Component({\n  selector: 'app-example',\n  imports: [MnFunnelChart],\n  template: `\n@let t = labels[language()];\n<mn-funnel-chart\n  [data]=\"[\n    { name: t[0], value: 180 },\n    { name: t[1], value: 940 },\n    { name: t[2], value: 42 },\n    { name: t[3], value: 410 },\n    { name: t[4], value: 31 }\n  ]\"\n  shape=\"bar\"\n  sort=\"descending\"\n  [height]=\"300\"\n/>\n  `,\n})\nexport class Example {\n  readonly language = injectMinerva().language;\n  labels = {\n  \"en\": [\"Interviews\", \"Applications\", \"Offers\", \"Screenings\", \"Hires\"],\n  \"zh\": [\"面试\", \"申请\", \"录用通知\", \"筛选\", \"入职\"],\n  \"ja\": [\"面接\", \"応募\", \"内定\", \"書類選考\", \"採用\"],\n  \"fr\": [\"Entretiens\", \"Candidatures\", \"Offres\", \"Présélections\", \"Embauches\"]\n};\n}\n"
      },
      "dependencies": [
        "@angular/core",
        "minerva-design"
      ],
      "contextImports": []
    }
