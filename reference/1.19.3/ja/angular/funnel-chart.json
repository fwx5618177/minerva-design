  "documentationContext": {
    "translationResources": {
      "title": "ファネルチャート",
      "description": "途中で数が減っていくプロセスの各段階（登録、営業パイプライン、購入手続き）を、段階ごとのコンバージョン率とともに示します。ホバーまたは矢印キーでステージをハイライトし、凡例の項目をクリックすると非表示にできます。",
      "demos": {
        "basic": {
          "title": "基本",
          "description": "台形が次のステージに向かって細くなり、コンバージョン率を表示します。renderTooltip で訪問者に対する割合と離脱数を React で追加しています。"
        },
        "bars": {
          "title": "バーと並べ替え",
          "description": "shape=\"bar\" は順序のない値を中央揃えのバーで描きます。sort で並べ替え（アニメーション付き）、conversion={false} で率を非表示にします。"
        },
        "ecommerce": {
          "title": "EC の購入フロー",
          "description": "ネットショップの購入ファネルの横に、段階間の離脱率を Table で示します。最も離脱の多い段階は両方で赤く強調されます。"
        },
        "recruiting": {
          "title": "採用パイプライン",
          "description": "1 つの職種の応募から採用までの候補者を段階ごとに色を変えた棒で表示します。ツールチップに段階の標準的な所要時間を加え、クリックで選択できます。"
        },
        "compare": {
          "title": "セグメントの比較",
          "description": "同じファネルをデバイス別に分けて並べ、段階をそろえてセグメントごとに色を変え、モバイルのユーザーがどこで離脱するかを確認します。"
        },
        "campaigns": {
          "title": "チャネル別のマーケティングファネル",
          "description": "Select でファネルを 1 つの獲得チャネルに絞り込むと、各ステージが新しい件数へアニメーションします。renderTooltip はチャネルの費用から計算した前ステージからの転換率と成果あたりのコストを追加し、下の文は顧客獲得コストを示します。"
        },
        "what-if": {
          "title": "転換率の what-if モデル",
          "description": "−1 / +1 ボタンで購入手続きの 1 ステップの転換率を変えると、訪問数からファネルを再計算します。サマリーは注文数と売上を現在の転換率と比較します。転換率は整数のパーセントポイントで保持するため、「リセット」は変更がないことを正しく判定できます。"
        },
        "live-sale": {
          "title": "ライブのタイムセール",
          "description": "1 時間のセールを 30 回の更新で再生します（setInterval、一時停止・終了・アンマウント時に解除）。新しい訪問者がシード付き乱数で各ステージを下っていきます。ステータス行は時刻に合わせて更新され、通知するのはセールの終了だけです。"
        },
        "sales-pipeline": {
          "title": "B2B の営業パイプライン",
          "description": "各ステージの大きさはオープン案件の金額で、ステージごとに異なる案件を含むため conversion={false} にしています。onClick でファネルの横にそのステージの案件を一覧表示し、renderTooltip は件数と受注確率を表示します。"
        }
      },
