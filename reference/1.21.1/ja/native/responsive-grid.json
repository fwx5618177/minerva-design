  "examples": [
    {
      "id": "basic",
      "kind": "internal-demo",
      "entry": "apps/docs/src/docs/pages/responsive-grid/native/basic.tsx",
      "files": {
        "apps/docs/src/docs/pages/responsive-grid/native/basic.tsx": "import { useState } from \"react\";\nimport { ResponsiveGrid, GridItem, Button } from \"minerva-design/native\";\nexport default function Basic() {\n  const [count, setCount] = useState(0);\n  return (\n    <ResponsiveGrid columns={{ base: 1, sm: 2 }} gap={3}>\n      <GridItem text=\"Project A\" />\n      <GridItem text=\"Project B\" />\n      <GridItem fullWidth text=\"Spans the complete row\" />\n      <GridItem fullWidth asChild>\n        <Button onPress={() => setCount((value) => value + 1)}>\n          {`Slotted full row: ${count}`}\n        </Button>\n      </GridItem>\n    </ResponsiveGrid>\n  );\n}\n"
      },
      "dependencies": [
        "minerva-design",
        "react"
      ],
      "contextImports": [],
      "title": "レスポンシブな列",
      "description": "columns は利用可能幅 0・480・768・1200px に対応する base / sm / md / lg の列数を受け付けます。"
    }
  ],
