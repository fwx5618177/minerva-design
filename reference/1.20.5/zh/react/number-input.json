  "examples": [
    {
      "id": "basic",
      "kind": "internal-demo",
      "entry": "apps/docs/src/docs/pages/number-input/demos/basic.tsx",
      "files": {
        "apps/docs/src/docs/pages/number-input/demos/basic.tsx": "import { NumberInput } from \"minerva-design\";\nimport { useState } from \"react\";\n\nexport default function BasicDemo() {\n  const [quantity, setQuantity] = useState<number | null>(1);\n  return (\n    <>\n      <NumberInput\n        aria-label=\"Quantity\"\n        min={0}\n        max={10}\n        value={quantity}\n        onChange={setQuantity}\n      />\n      <p>Value: {quantity === null ? \"empty\" : quantity}</p>\n    </>\n  );\n}\n"
      },
      "dependencies": [
        "minerva-design",
        "react"
      ],
      "contextImports": [],
      "title": "基础用法",
      "description": "超出范围或非数字的草稿会被标记，提交时被限制或还原；清空得到 null。"
    },
    {
      "id": "form-control",
      "kind": "internal-demo",
      "entry": "apps/docs/src/docs/pages/number-input/demos/form-control.tsx",
      "files": {
        "apps/docs/src/docs/pages/number-input/demos/form-control.tsx": "import { FormField, NumberInput } from \"minerva-design\";\n\nexport default function FormControlDemo() {\n  return (\n    <>\n      <FormField label=\"HTTP status\" helperText=\"Between 100 and 599.\" required>\n        <NumberInput defaultValue={200} min={100} max={599} />\n      </FormField>\n      <FormField label=\"Retries\" readOnly>\n        <NumberInput defaultValue={3} />\n      </FormField>\n    </>\n  );\n}\n"
      },
      "dependencies": [
        "minerva-design"
      ],
      "contextImports": [],
      "title": "配合 FormField",
      "description": "字段提供标签、状态和描述；readOnly 会阻止输入和步进。"
    },
    {
      "id": "stepper-precision",
      "kind": "internal-demo",
      "entry": "apps/docs/src/docs/pages/number-input/demos/stepper-precision.tsx",
      "files": {
