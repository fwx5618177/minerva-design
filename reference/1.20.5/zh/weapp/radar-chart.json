    "translationResources": {
      "title": "雷达图",
      "description": "在多个量纲不同的指标上比较一个或少数几个对象（技能评估、产品评测、风味特征）。悬停多边形可高亮它及最近的指标；方向键在系列和指标之间移动，Esc 清除；点击图例项可隐藏系列。",
      "demos": {
        "basic": {
          "title": "基础",
          "description": "一个系列、六个指标，max 为 10；提示框列出所有数值，并加粗指针下方的指标。"
        },
        "compare": {
          "title": "产品对比",
          "description": "三个系列时自动显示图例；onHover 返回当前系列及离指针最近的指标。"
        },
        "circle": {
          "title": "圆形网格",
          "description": "shape=\"circle\" 绘制圆形网格，levels 设置环数，dots={false} 隐藏顶点；opacity 加深填充。"
        },
        "players": {
          "title": "球员对比",
          "description": "两名足球运动员的六项能力；指标上的 min 和 max 把每个轴放大到评分有差异的 30-99 区间，每个系列设置自己的颜色。"
        },
        "capabilities": {
          "title": "产品能力",
          "description": "分析师对我们的产品、竞品和市场平均水平的评分。hidden 让可见性变为受控：复选框和图例（onToggle）共用同一个状态。"
        },
        "nutrition": {
          "title": "早餐营养成分",
          "description": "三种早餐绘制在圆形网格上（shape=\"circle\"，levels={5}），每条轴以每日参考值的百分比表示。renderTooltip 使用事件的 indicator 列出每份早餐中所悬停营养素的含量。"
        },
        "live-monitor": {
          "title": "实时服务监控",
          "description": "当前负载每秒重绘一次（setInterval，在关闭开关或卸载时清除），叠加在过去一小时的基线之上，超过告警阈值时变为红色。只播报负载最高的指标和告警状态，而不是每次刷新。"
        },
        "review-360": {
          "title": "360 度评估",
          "description": "通过 Select 选择要与团队平均值对比的人员；将该人员始终作为第二个系列，多边形就会原地过渡。下方文字指出其相对团队的最大优势和最大差距。"
        },
        "sales-targets": {
          "title": "单位各异的销售目标",
          "description": "每个指标都有自己的 min 和 max，因此收入、成交数、赢单率和 NPS 可以共用一张图；目标是未填充的轮廓。onClick 和 renderTooltip 读取事件的 indicator，显示某个 KPI 的实际值、目标和达成率。"
        }
      },
