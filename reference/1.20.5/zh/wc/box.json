  "examples": [
    {
      "id": "basic",
      "kind": "internal-demo",
      "entry": "apps/docs/src/docs/pages/box/wc/basic.html",
      "files": {
        "apps/docs/src/docs/pages/box/wc/basic.html": "<minerva-box p=\"4\" bg=\"bg.muted\" rounded=\"md\">\n  Padding from the spacing scale, a surface background and a radius token.\n</minerva-box>\n<minerva-box\n  p=\"4\"\n  mt=\"3\"\n  rounded=\"lg\"\n  box-shadow=\"md\"\n  border=\"1px solid var(--border-color)\"\n>\n  An elevated box with a shadow token and a CSS border.\n</minerva-box>\n"
      },
      "dependencies": [],
      "contextImports": [],
      "title": "基本用法",
      "description": "元素本身就是盒子：p、bg、rounded、box-shadow 和 border 都作用于宿主元素。"
    },
    {
      "id": "spacing-sizing",
      "kind": "internal-demo",
      "entry": "apps/docs/src/docs/pages/box/wc/spacing-sizing.html",
      "files": {
        "apps/docs/src/docs/pages/box/wc/spacing-sizing.html": "<minerva-box bg=\"bg.subtle\" p=\"2\" rounded=\"md\">\n  <minerva-box bg=\"bg.muted\" px=\"6\" py=\"2\" mb=\"3\" rounded=\"sm\">\n    px=\"6\" py=\"2\" mb=\"3\": spacing tokens\n  </minerva-box>\n  <minerva-box bg=\"bg.muted\" p=\"12px\" mx=\"auto\" w=\"240\" rounded=\"sm\">\n    p=\"12px\" mx=\"auto\" w=\"240\": CSS values and pixels\n  </minerva-box>\n  <minerva-box bg=\"bg.muted\" p=\"3\" mt=\"3\" max-w=\"60%\" min-h=\"80\" rounded=\"sm\">\n    max-w=\"60%\" min-h=\"80\"\n  </minerva-box>\n</minerva-box>\n"
      },
      "dependencies": [],
      "contextImports": [],
      "title": "间距与尺寸",
      "description": "数字会选择间距令牌（p=\"4\" 即 var(--space-4)），其他字符串作为 CSS 值；尺寸（w、h、min-/max-）为像素或 CSS 长度。单边属性优先于轴向属性，轴向属性优先于四边简写。"
    },
    {
      "id": "surfaces",
      "kind": "internal-demo",
      "entry": "apps/docs/src/docs/pages/box/wc/surfaces.html",
      "files": {
        "apps/docs/src/docs/pages/box/wc/surfaces.html": "<div\n  style=\"\n    display: grid;\n    gap: 12px;\n    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));\n  \"\n>\n  <minerva-box p=\"4\" bg=\"bg\" rounded=\"md\" border=\"1px solid var(--border-color)\"\n    >bg</minerva-box\n  >\n  <minerva-box p=\"4\" bg=\"bg.subtle\" rounded=\"md\">bg.subtle</minerva-box>\n  <minerva-box p=\"4\" bg=\"bg.muted\" rounded=\"md\">bg.muted</minerva-box>\n  <minerva-box p=\"4\" bg=\"bg.canvas\" rounded=\"md\">bg.canvas</minerva-box>\n  <minerva-box p=\"4\" bg=\"bg.elevated\" rounded=\"lg\" box-shadow=\"sm\"\n    >box-shadow=\"sm\"</minerva-box\n  >\n  <minerva-box p=\"4\" bg=\"bg.elevated\" rounded=\"xl\" box-shadow=\"lg\"\n    >box-shadow=\"lg\"</minerva-box\n  >\n  <minerva-box p=\"4\" bg=\"bg.muted\" rounded=\"full\" style=\"text-align: center\"\n    >rounded=\"full\"</minerva-box\n  >\n  <minerva-box\n    p=\"4\"\n    rounded=\"md\"\n    bg=\"linear-gradient(135deg, var(--primary-color), var(--info-color))\"\n    style=\"color: white\"\n    >CSS gradient</minerva-box\n  >\n</div>\n"
      },
      "dependencies": [],
      "contextImports": [],
      "title": "表面、圆角与阴影",
      "description": "bg 接受表面别名（bg、bg.subtle、bg.muted、bg.canvas、bg.elevated）或任意 CSS 背景；rounded 和 box-shadow 接受令牌或 CSS 值。"
    }
  ],
