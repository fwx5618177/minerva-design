  "documentationContext": {
    "translationResources": {
      "title": "ゲージ",
      "description": "1 つの値を範囲とともに円弧上に表示し、色付きのしきい値も設定できます：KPI、使用率、スコアなど。value を変えると、円弧（と針）が現在の位置からアニメーションします。",
      "demos": {
        "basic": {
          "title": "基本",
          "description": "それぞれ色・ラベル・書式を設定した 3 つの小さなゲージ。"
        },
        "bands": {
          "title": "範囲と針",
          "description": "bands でトラックを範囲ごとに色分けし（赤・黄・緑）、値の円弧はその範囲の色になります。needle で値を指し示し、min には負の値も使えます。"
        },
        "live": {
          "title": "リアルタイムの値",
          "description": "タイマーが 1.5 秒ごとに value を更新し、ゲージが新しい値へアニメーションします。sweep={180} で半円を描き、thickness で円弧を太くしています。一時停止またはアンマウント時にタイマーを解除します。"
        },
        "speedometer": {
          "title": "スピードメーター",
          "description": "細い円弧と針を持つゲージ。ボタン（または Space / Enter）を押し続けると加速・ブレーキします。animation={false} で針が状態に直接追従し、単位は Intl.NumberFormat が付けます。"
        },
        "quota": {
          "title": "クォータの使用量",
          "description": "プランのクォータごとにゲージを置き、各上限の 75% と 90% でバンドを分け、ticks={false} にして使用量と上限を下に添えます。"
        },
        "slo": {
          "title": "可用性とエラーバジェット",
          "description": "拡大したゲージ（min 99.5、max 100）で目標に対する可用性を、もう 1 つで残りのエラーバジェットを示します。詳細は renderTooltip で表示します。"
        },
        "thermostat": {
          "title": "スマートサーモスタット",
          "description": "− と + のボタンで目標温度を 0.5 度ずつ変更します。設定は °C で保存して表示時に換算するため、°F に切り替えると value・min・max・bands がまとめて変わります。renderTooltip は室温を、下の文は暖房・冷房・維持のどれかを示します。"
        },
        "credit-score": {
          "title": "クレジットスコア",
          "description": "300 から 850 までの 5 つの評価帯の上に針を表示し、min と max をスコアの範囲に設定しています。Select で申請者を切り替えると針が新しいスコアへ動きます。renderTooltip は評価を、event.percent は範囲内の位置を示します。"
        },
        "battery": {
          "title": "電気自動車の充電",
          "description": "半円のゲージ（sweep={180}）は接続中に 400 ms ごとに増え、80 % を超えると遅くなります。プラグを抜いたとき、満充電のとき、アンマウント時にインターバルを止めます。通知するのは充電フェーズだけで、航続距離と 80 % までの時間は Intl.NumberFormat の単位で表示します。"
        },
        "dark-panel": {
          "title": "ダークなコントロールパネル",
          "description": "CSS 変数がダークテーマに切り替わるパネル上の 3 つの針付きゲージです。チャートは <html> と <body> しか監視しないため、コンテナのスタイル変更後に ref から各チャートの refreshTheme() を呼び出します。"
        }
      },
