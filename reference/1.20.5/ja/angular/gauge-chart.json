  "examples": [
    {
      "id": "bands",
      "title": "範囲と針",
      "description": "bands でトラックを範囲ごとに色分けし（赤・黄・緑）、値の円弧はその範囲の色になります。needle で値を指し示し、min には負の値も使えます。",
      "kind": "internal-demo",
      "entry": "example.ts",
      "files": {
        "example.ts": "import { Component } from '@angular/core';\nimport { MnGaugeChart, injectMinerva } from 'minerva-design/angular';\n\n@Component({\n  selector: 'app-example',\n  imports: [MnGaugeChart],\n  template: `\n<mn-gauge-chart\n  [value]=\"72\"\n  [label]=\"labels[language()]\"\n  [bands]=\"[\n    { to: 60, color: 'var(--success-color, #16a34a)' },\n    { to: 85, color: 'var(--warning-color, #f59e0b)' },\n    { to: 100, color: 'var(--danger-color, #dc2626)' }\n  ]\"\n/>\n  `,\n})\nexport class Example {\n  readonly language = injectMinerva().language;\n  labels = {\n  \"en\": \"CPU load\",\n  \"zh\": \"CPU 负载\",\n  \"ja\": \"CPU 負荷\",\n  \"fr\": \"Charge CPU\"\n};\n}\n"
      },
      "dependencies": [
        "@angular/core",
        "minerva-design"
      ],
      "contextImports": []
    },
    {
      "id": "needle",
      "title": "Needle and custom scale",
      "description": "",
      "kind": "internal-demo",
      "entry": "example.ts",
      "files": {
        "example.ts": "import { Component } from '@angular/core';\nimport { MnGaugeChart, injectMinerva } from 'minerva-design/angular';\n\n@Component({\n  selector: 'app-example',\n  imports: [MnGaugeChart],\n  template: `\n<mn-gauge-chart\n  [value]=\"128\"\n  [max]=\"200\"\n  [label]=\"labels[language()]\"\n  needle\n  [sweep]=\"270\"\n  [thickness]=\"0.1\"\n  [height]=\"260\"\n/>\n  `,\n})\nexport class Example {\n  readonly language = injectMinerva().language;\n  labels = {\n  \"en\": \"Speed (km/h)\",\n  \"zh\": \"速度（公里/小时）\",\n  \"ja\": \"速度（km/h）\",\n  \"fr\": \"Vitesse (km/h)\"\n};\n}\n"
      },
      "dependencies": [
        "@angular/core",
        "minerva-design"
      ],
      "contextImports": []
    }
  ],
