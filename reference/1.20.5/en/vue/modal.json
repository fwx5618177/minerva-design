  "examples": [
    {
      "id": "basic",
      "kind": "internal-demo",
      "entry": "apps/docs/src/docs/pages/modal/vue/basic.vue",
      "files": {
        "apps/docs/src/docs/pages/modal/vue/basic.vue": "<script setup lang=\"ts\">\nimport { ref } from \"vue\";\nimport {\n  Button,\n  Modal,\n  ModalBody,\n  ModalFooter,\n  VStack,\n} from \"minerva-design/vue\";\nconst open = ref(false);\nconst deleted = ref(false);\nfunction remove() {\n  deleted.value = true;\n  open.value = false;\n}\n</script>\n<template>\n  <VStack align=\"start\" :gap=\"3\"\n    ><Button @click=\"open = true\">Delete record</Button>\n    <p v-if=\"deleted\" role=\"status\">Record deleted</p>\n    <Modal\n      v-model:open=\"open\"\n      title=\"Delete this record?\"\n      description=\"The record and its history are removed permanently.\"\n      size=\"small\"\n      ><ModalBody>Other team members lose access immediately.</ModalBody\n      ><ModalFooter\n        ><Button color=\"neutral\" variant=\"outline\" @click=\"open = false\"\n          >Cancel</Button\n        ><Button color=\"danger\" @click=\"remove\">Delete</Button></ModalFooter\n      ></Modal\n    ></VStack\n  >\n</template>\n"
      },
      "dependencies": [
        "minerva-design",
        "vue"
      ],
      "contextImports": [],
      "title": "basic",
      "description": ""
    },
    {
      "id": "events",
      "kind": "internal-demo",
      "entry": "apps/docs/src/docs/pages/modal/vue/events.vue",
      "files": {
        "apps/docs/src/docs/pages/modal/vue/events.vue": "<script setup lang=\"ts\">\nimport { ref } from \"vue\";\nimport { Modal, ModalBody, Button } from \"minerva-design/vue\";\nconst open = ref(false);\nconst last = ref(\"\");\n</script>\n<template>\n  <Button @click=\"open = true\">Open tracked dialog</Button\n  ><Modal\n    v-model:open=\"open\"\n    title=\"Dialog events\"\n    @open-change=\"(value) => (last = value ? 'Opened' : 'Closed')\"\n    ><ModalBody\n      ><p>\n        Escape, the close button, or the backdrop closes this dialog.\n      </p></ModalBody\n    ></Modal\n  ><output>{{ last }}</output>\n</template>\n"
      },
      "dependencies": [
        "minerva-design",
        "vue"
      ],
      "contextImports": [],
      "title": "events",
      "description": ""
    },
    {
      "id": "form",
      "kind": "internal-demo",
      "entry": "apps/docs/src/docs/pages/modal/vue/form.vue",
      "files": {
        "apps/docs/src/docs/pages/modal/vue/form.vue": "<script setup lang=\"ts\">\nimport { ref } from \"vue\";\nimport {\n  Button,\n  Input,\n  FormField,\n  Modal,\n  ModalBody,\n  ModalFooter,\n} from \"minerva-design/vue\";\nconst open = ref(false);\nconst name = ref(\"Quarterly report\");\nconst draft = ref(name.value);\nfunction edit() {\n  draft.value = name.value;\n  open.value = true;\n}\nfunction save() {\n  name.value = draft.value;\n  open.value = false;\n}\n</script>\n<template>\n  <Button @click=\"edit\">Rename “{{ name }}”</Button\n  ><Modal v-model:open=\"open\" title=\"Rename document\"\n    ><form @submit.prevent=\"save\">\n      <ModalBody\n        ><FormField label=\"Name\"\n          ><Input v-model=\"draft\" name=\"name\" /></FormField></ModalBody\n      ><ModalFooter><Button type=\"submit\">Save</Button></ModalFooter>\n    </form></Modal\n  >\n</template>\n"
      },
      "dependencies": [
        "minerva-design",
        "vue"
      ],
      "contextImports": [],
      "title": "form",
      "description": ""
    },
    {
      "id": "sizes",
      "kind": "internal-demo",
      "entry": "apps/docs/src/docs/pages/modal/vue/sizes.vue",
      "files": {
        "apps/docs/src/docs/pages/modal/vue/sizes.vue": "<script setup lang=\"ts\">\nimport { ref } from \"vue\";\nimport { Modal, ModalBody, Button, HStack } from \"minerva-design/vue\";\nconst sizes = [\"small\", \"medium\", \"large\", \"full\"] as const;\nconst size = ref<(typeof sizes)[number]>(\"medium\");\nconst open = ref(false);\n</script>\n<template>\n  <HStack :gap=\"3\" wrap\n    ><Button\n      v-for=\"item in sizes\"\n      :key=\"item\"\n      variant=\"outline\"\n      @click=\"\n        size = item;\n        open = true;\n      \"\n      >{{ item }}</Button\n    ></HStack\n  ><Modal v-model:open=\"open\" :size=\"size\" :title=\"`${size} dialog`\"\n    ><ModalBody\n      ><p>Choose a size appropriate for your content.</p></ModalBody\n    ></Modal\n  >\n</template>\n"
      },
      "dependencies": [
        "minerva-design",
        "vue"
      ],
      "contextImports": [],
      "title": "sizes",
      "description": ""
    }
  ],
