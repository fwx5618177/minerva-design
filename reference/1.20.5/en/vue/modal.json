      "wc": {
        "demos": {
          "basic": {
            "title": "Basic usage",
            "description": "The trigger slot opens the modal; label and description name and describe it. Focus is trapped, Escape and an overlay click close it, and focus returns to the opener."
          },
          "sizes": {
            "title": "Sizes",
            "description": "Five size presets, set before calling show(). The title comes from the header slot here."
          },
          "form": {
            "title": "Form in a modal",
            "description": "A footer submit button targets the form by id; the browser validates it, then the submit handler saves and calls hide()."
          },
          "events": {
            "title": "Events and guarded close",
            "description": "minerva-open-change is cancelable: while \"Unsaved changes\" is checked, preventDefault() keeps the modal open. The log shows the reason and the after-open / after-close events."
          }
        },
        "minerva-modal": {
