    "translationResources": {
      "title": "Modal",
      "description": "A dialog that interrupts the page for a focused task. Focus is trapped inside, Escape and a backdrop click close it, and focus returns to the opener. On narrow screens it becomes a bottom sheet.",
      "demos": {
        "basic": {
          "title": "Basic usage",
          "description": "Cancel closes without deleting. Delete closes the dialog and displays Record deleted."
        },
        "uncontrolled": {
          "title": "Uncontrolled with a trigger",
          "description": "Pass trigger to let the modal manage its own state."
        },
        "sizes": {
          "title": "Sizes",
          "description": "small, medium (default), large, xlarge and full."
        },
        "form": {
          "title": "Form",
          "description": "Rename Quarterly report by editing Name and pressing Save. The trigger then displays the saved name."
        },
        "compound": {
          "title": "Compound API",
          "description": "ModalRoot, ModalTrigger, ModalContent, ModalHeader, ModalBody, ModalFooter and ModalClose for full control."
        }
      },
