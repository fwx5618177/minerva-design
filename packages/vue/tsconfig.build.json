{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vite/client"],
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "paths": {
      "@react-styles/*": ["../react/src/*"],
      "minerva-design/charts/core": ["../minerva-design/dist/charts/core.d.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/__tests__", "src/test-utils"]
}
