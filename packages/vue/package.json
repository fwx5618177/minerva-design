{
  "name": "@minerva/vue",
  "version": "0.0.0",
  "private": true,
  "description": "Private workspace package (planned): the native Vue 3 renderer of Minerva, to be published inside minerva-design as minerva-design/vue",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"console.log('@minerva/vue: planned renderer, nothing to build yet')\"",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "clean": "rimraf coverage"
  },
  "dependencies": {
    "@minerva/core": "workspace:*",
    "@minerva/dom": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/vue": "catalog:vue",
    "@vitejs/plugin-vue": "catalog:vue",
    "@vue/test-utils": "catalog:vue",
    "happy-dom": "^20.14.5",
    "vue": "catalog:vue",
    "vue-tsc": "catalog:vue"
  }
}
