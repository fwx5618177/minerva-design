{
  "name": "@minerva/vue",
  "version": "0.0.0",
  "private": true,
  "description": "Private workspace package: sources of the native Vue 3 renderer of Minerva (single-file components and composables), published inside minerva-design as minerva-design/vue",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./monaco": "./src/monaco.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "clean": "rimraf coverage"
  },
  "dependencies": {
    "@minerva/core": "workspace:*",
    "@minerva/dom": "workspace:*",
    "dompurify": "^3.4.16",
    "jsonc-parser": "^3.3.1"
  },
  "peerDependencies": {
    "monaco-editor": ">=0.52.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "monaco-editor": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/vue": "catalog:vue",
    "@vitejs/plugin-vue": "catalog:vue",
    "@vue/test-utils": "catalog:vue",
    "happy-dom": "^20.14.5",
    "monaco-editor": "0.52.2",
    "vue": "catalog:vue",
    "vue-tsc": "catalog:vue"
  }
}
