{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "types": ["node", "vite/client"],
    "paths": {
      "@minerva/core/styling-hooks": ["../core/src/styling-hooks/index.ts"],
      "@minerva/core/contracts": ["../core/src/contracts/index.ts"],
      "@minerva/core": ["../core/src/index.ts"],
      "@minerva/dom": ["../dom/src/index.ts"],
      "@react-styles/*": ["../react/src/*"]
    }
  },
  "vueCompilerOptions": {
    "strictTemplates": false
  },
  "include": ["src", "spike", "tests", "vite.config.ts"]
}
