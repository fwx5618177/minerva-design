{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // RN types declare their own timers / fetch globals: no DOM lib
    "lib": ["ES2022"],
    "jsx": "react-jsx",
    "types": ["vitest/globals", "node"],
    "paths": {
      "@minerva/core": ["../core/src/index.ts"]
    }
  },
  "include": ["src", "test", "vite.config.ts", "vitest.config.ts", "vitest.web.config.ts"]
}
