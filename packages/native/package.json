{
  "name": "@minerva/native",
  "version": "0.0.0",
  "private": true,
  "description": "Private workspace package: sources of the Minerva React Native + Expo components, published inside minerva-design (minerva-design/native)",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./manifest": "./src/manifest.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run && vitest run -c vitest.web.config.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf coverage"
  },
  "dependencies": {
    "@minerva/core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-native": ">=0.79.0"
  },
  "devDependencies": {
    "@react-native/babel-preset": "catalog:native",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/react-native": "catalog:native",
    "@types/react": "catalog:native",
    "@types/react-dom": "catalog:native",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-module-resolver": "catalog:native",
    "happy-dom": "^20.14.5",
    "react": "catalog:native",
    "react-dom": "catalog:native",
    "react-native": "catalog:native",
    "react-native-testing-mocks": "catalog:native",
    "react-native-web": "catalog:native",
    "test-renderer": "catalog:native",
    "vite-plugin-dts": "^5.1.2"
  }
}
