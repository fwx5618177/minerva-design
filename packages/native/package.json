{
  "name": "@minerva/native",
  "version": "0.0.0",
  "private": true,
  "description": "Private workspace package (planned): the React Native + Expo renderer of Minerva, to be published inside minerva-design as minerva-design/native",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"console.log('@minerva/native: planned renderer, nothing to build yet')\"",
    "test": "vitest run && vitest run -c vitest.web.config.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf coverage"
  },
  "dependencies": {
    "@minerva/core": "workspace:*"
  },
  "devDependencies": {
    "@react-native/babel-preset": "catalog:native",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/react-native": "catalog:native",
    "@types/react": "catalog:native",
    "@types/react-dom": "catalog:native",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-module-resolver": "catalog:native",
    "happy-dom": "^20.14.5",
    "react": "catalog:native",
    "react-dom": "catalog:native",
    "react-native": "catalog:native",
    "react-native-testing-mocks": "catalog:native",
    "react-native-web": "catalog:native",
    "test-renderer": "catalog:native"
  }
}
