{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "react-jsx",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "types": ["node"],
    "strict": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@components/*": ["./src/components/*"],
      "@layout/*": ["./src/layout/*"],
      "@pages/*": ["./src/pages/*"],
      "@styles/*": ["./src/styles/*"],
      "@i18n/*": ["./src/i18n/*"],
      "@router/*": ["./src/router/*"],
      "@minerva/lib-core": ["../lib-core/src/index.ts"],
      "@minerva/lib-core/theme-utils": ["../lib-core/src/theme-utils.ts"],
      "@minerva/lib-core/utils": ["../lib-core/src/utils-entry.ts"],
      "@minerva/lib-core/monaco": ["../lib-core/src/monaco.ts"],
      "@minerva/core/styling-hooks": ["../core/src/styling-hooks/index.ts"],
      "@minerva/core": ["../core/src/index.ts"],
      "@minerva/lib-web-components": ["../lib-web-components/src/index.ts"],
      "@minerva/lib-web-components/*": ["../lib-web-components/src/elements/*.ts"]
    },
    "noUncheckedSideEffectImports": false
  },
  "include": ["src", "global.d.ts", "vite.config.ts"]
}
