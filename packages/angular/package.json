{
  "name": "@minerva/angular",
  "version": "0.0.0",
  "private": true,
  "description": "Private workspace package: sources of the native Angular renderer of Minerva (standalone components, signals), published inside minerva-design as minerva-design/angular",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./monaco": "./monaco/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "ngc -p tsconfig.json",
    "styles": "node scripts/styles.mjs",
    "clean": "rimraf coverage build"
  },
  "dependencies": {
    "@minerva/core": "workspace:*",
    "@minerva/dom": "workspace:*"
  },
  "peerDependencies": {
    "@angular/common": ">=22.0.0 <23.0.0",
    "@angular/core": ">=22.0.0 <23.0.0",
    "@angular/forms": ">=22.0.0 <23.0.0",
    "monaco-editor": ">=0.52.0",
    "@angular/platform-browser": ">=22.0.0 <23.0.0"
  },
  "peerDependenciesMeta": {
    "monaco-editor": {
      "optional": true
    }
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "catalog:angular",
    "@analogjs/vitest-angular": "catalog:angular",
    "@angular/build": "catalog:angular",
    "@angular/common": "catalog:angular",
    "@angular/compiler": "catalog:angular",
    "@angular/compiler-cli": "catalog:angular",
    "@angular/core": "catalog:angular",
    "@angular/forms": "catalog:angular",
    "@angular/platform-browser": "catalog:angular",
    "@angular/platform-server": "catalog:angular",
    "@testing-library/user-event": "^14.6.7",
    "happy-dom": "^20.14.5",
    "monaco-editor": "0.52.2",
    "ng-packagr": "catalog:angular",
    "rxjs": "catalog:angular",
    "sass": "^1.105.1",
    "tslib": "catalog:angular",
    "typescript": "~6.0.3"
  }
}
