{
  "name": "@minerva/angular",
  "version": "0.0.0",
  "private": true,
  "description": "Private workspace package (planned): the native Angular renderer of Minerva, to be published inside minerva-design as minerva-design/angular",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"console.log('@minerva/angular: planned renderer, nothing to build yet')\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf coverage"
  },
  "dependencies": {
    "@minerva/core": "workspace:*",
    "@minerva/dom": "workspace:*"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "catalog:angular",
    "@analogjs/vitest-angular": "catalog:angular",
    "@angular/build": "catalog:angular",
    "@angular/common": "catalog:angular",
    "@angular/compiler": "catalog:angular",
    "@angular/compiler-cli": "catalog:angular",
    "@angular/core": "catalog:angular",
    "@angular/platform-browser": "catalog:angular",
    "happy-dom": "^20.14.5",
    "rxjs": "catalog:angular",
    "tslib": "catalog:angular"
  }
}
