{
  "name": "@minerva/core",
  "version": "0.0.0",
  "private": true,
  "description": "Private workspace package: the platform-neutral core of Minerva (tokens, theme data, i18n, headless state machines, component contracts, pure helpers), published inside minerva-design (dist/core, minerva-design/core)",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styling-hooks": "./src/styling-hooks/index.ts",
    "./contracts": "./src/contracts/index.ts",
    "./tokens.css": "./src/theme/tokens.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "test": "vitest run",
    "hooks:lock": "vitest run src/styling-hooks --update",
    "tokens:generate": "vitest run src/tokens/generated.test.ts --update",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf coverage"
  }
}
