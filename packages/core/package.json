{
  "name": "@minerva/core",
  "version": "0.0.0",
  "private": true,
  "description": "Private workspace package: framework-agnostic DOM primitives and theming of Minerva, published inside minerva-design (minerva-design/core)",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styling-hooks": "./src/styling-hooks/index.ts",
    "./tokens.css": "./src/theme/tokens.scss",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "test": "vitest run",
    "hooks:lock": "vitest run src/styling-hooks --update",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf coverage"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0"
  },
  "devDependencies": {
    "sass": "^1.105.1"
  }
}
