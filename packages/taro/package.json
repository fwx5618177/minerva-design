{
  "name": "@minerva/taro",
  "version": "0.0.0",
  "private": true,
  "description": "Private workspace package (planned): the Taro renderer of Minerva (React-syntax mini-programs + H5), to be published inside minerva-design as minerva-design/taro",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
