    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf coverage"
  },
  "dependencies": {
    "@minerva/core": "workspace:*"
  },
  "devDependencies": {
    "@tarojs/components": "catalog:taro",
    "@tarojs/components-react": "catalog:taro",
    "@tarojs/runtime": "catalog:taro",
    "@tarojs/shared": "catalog:taro",
    "@tarojs/taro": "catalog:taro",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "catalog:taro",
    "@types/react-dom": "catalog:taro",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^20.14.5",
    "react": "catalog:taro",
    "react-dom": "catalog:taro"
  }
}
