<mn-config-provider theme="{{theme}}" disable-storage="{{true}}">
<mn-button id="increment" bindclick="increment">Increment</mn-button><text id="count">Count: {{count}}</text>
<mn-input id="controlled-input" value="{{text}}" placeholder="Controlled name" bindchange="input"/><text>Owner: {{text}}</text>
<mn-switch id="locked-switch" checked="{{checked}}" disabled="{{true}}" label="Locked switch" bindchange="changeSwitch"/><text>Disabled events: {{switchEvents}}</text>
<mn-select id="choice" options="{{options}}" value="{{choice}}" bindchange="select"/><text>Selection: {{choice}}</text>
<mn-button id="open-modal" bindclick="openModal">Open native modal</mn-button><mn-modal id="dialog" open="{{open}}" title="Native dialog" bindopenchange="modal"><text>Real native overlay</text></mn-modal>
<mn-button id="toggle-theme" bindclick="theme">Toggle theme</mn-button><text>Theme: {{theme}}</text>
<mn-config-provider theme="dark" disable-storage="{{true}}"><mn-loading-state id="retry-state" loading="{{false}}" error="Offline" retry-label="Reconnect" bindretry="increment"/></mn-config-provider>
</mn-config-provider>
