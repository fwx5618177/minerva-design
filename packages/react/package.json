{
  "name": "@minerva/react",
  "version": "0.0.0",
  "private": true,
  "description": "Private workspace package: sources of the Minerva React 19 components, published inside minerva-design (the main entry)",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./theme-utils": "./src/theme-utils.ts",
    "./utils": "./src/utils-entry.ts",
    "./monaco": "./src/monaco.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf coverage"
  },
  "dependencies": {
    "@minerva/core": "workspace:*",
    "@minerva/dom": "workspace:*",
    "dompurify": "^3.4.16",
    "jsonc-parser": "^3.3.1"
  },
  "peerDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "monaco-editor": ">=0.52.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@monaco-editor/react": {
      "optional": true
    },
    "monaco-editor": {
      "optional": true
    }
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "jsdom": "^30.1.2",
    "monaco-editor": "0.52.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
