{
  "name": "@minerva/lib-core",
  "version": "1.0.0",
  "description": "Minerva React component library (layout, forms, overlays, data display, navigation, editors, theming)",
  "license": "MIT",
  "author": "fwx5618177 <fwx5618177@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fwx5618177/minerva.git",
    "directory": "packages/lib-core"
  },
  "homepage": "https://fwx5618177.github.io/minerva/",
  "keywords": [
    "react",
    "components",
    "ui"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./theme-utils": {
      "import": {
        "types": "./dist/theme-utils.d.ts",
        "default": "./dist/theme-utils.js"
      },
      "require": {
        "types": "./dist/theme-utils.d.cts",
        "default": "./dist/theme-utils.cjs"
      }
    },
    "./monaco": {
      "import": {
        "types": "./dist/monaco.d.ts",
        "default": "./dist/monaco.js"
      },
      "require": {
        "types": "./dist/monaco.d.cts",
        "default": "./dist/monaco.cjs"
      }
    },
    "./style.css": "./dist/style.css",
    "./styles/*.css": "./dist/styles/*.css",
    "./prose.scss": "./dist/prose.scss",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "(cd ../core && vite build) && vite build",
    "watch": "vite build --watch",
    "test": "vitest run",
    "test:dist": "vitest run --config vitest.dist.config.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist coverage",
    "check:package": "publint && attw --pack . --exclude-entrypoints ./style.css ./prose.scss ./styles/*.css"
  },
  "dependencies": {
    "@minerva/core": "workspace:*",
    "dompurify": "^3.4.16",
    "jsonc-parser": "^3.3.1"
  },
  "peerDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "monaco-editor": ">=0.52.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "jsdom": "^30.1.2",
    "monaco-editor": "0.52.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rolldown": "1.2.12"
  },
  "peerDependenciesMeta": {
    "@monaco-editor/react": {
      "optional": true
    },
    "monaco-editor": {
      "optional": true
    }
  },
  "typesVersions": {
    "*": {
      "theme-utils": [
        "./dist/theme-utils.d.ts"
      ],
      "monaco": [
        "./dist/monaco.d.ts"
      ]
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
