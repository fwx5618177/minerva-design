{
  "name": "@minerva/lib-core",
  "version": "1.0.0",
  "description": "Minerva React component library",
  "license": "MIT",
  "author": "fwx5618177 <fwx5618177@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fwx5618177/minerva.git",
    "directory": "packages/lib-core"
  },
  "homepage": "https://fwx5618177.github.io/minerva/",
  "keywords": [
    "react",
    "components",
    "ui"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "test": "vitest run",
    "test:dist": "vitest run --config vitest.dist.config.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist coverage"
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "@floating-ui/react-dom": "^2.1.9",
    "i18next": "^26.4.2",
    "react-i18next": "^17.0.0",
    "react-icons": "^5.7.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
