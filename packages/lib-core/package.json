{
  "name": "@minerva/lib-core",
  "version": "1.0.0",
  "description": "Minerva React component library (layout, forms, overlays, data display, navigation, editors, theming)",
  "license": "MIT",
  "author": "fwx5618177 <fwx5618177@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fwx5618177/minerva.git",
    "directory": "packages/lib-core"
  },
  "homepage": "https://fwx5618177.github.io/minerva/",
  "keywords": [
    "react",
    "components",
    "ui"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./theme-utils": {
      "types": "./dist/theme-utils.d.ts",
      "import": "./dist/theme-utils.js",
      "require": "./dist/theme-utils.cjs"
    },
    "./monaco": {
      "types": "./dist/monaco.d.ts",
      "import": "./dist/monaco.js",
      "require": "./dist/monaco.cjs"
    },
    "./style.css": "./dist/style.css",
    "./prose.scss": "./dist/prose.scss",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "(cd ../core && vite build) && vite build",
    "watch": "vite build --watch",
    "test": "vitest run",
    "test:dist": "vitest run --config vitest.dist.config.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist coverage"
  },
  "dependencies": {
    "@minerva/core": "workspace:*",
    "dompurify": "^3.4.16",
    "i18next": "^26.4.2",
    "jsonc-parser": "^3.3.1",
    "react-i18next": "^17.0.0",
    "react-icons": "^5.7.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@monaco-editor/react": "^4.7.0",
    "monaco-editor": ">=0.52.0"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "jsdom": "^30.1.2",
    "monaco-editor": "0.52.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "peerDependenciesMeta": {
    "@monaco-editor/react": {
      "optional": true
    },
    "monaco-editor": {
      "optional": true
    }
  }
}
