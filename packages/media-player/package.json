{
  "name": "@minerva/media-player",
  "version": "0.0.0",
  "private": true,
  "description": "Private workspace: shared web media playback engine and React controls, published through minerva-design/media-player",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./engines": "./src/engines/index.ts",
    "./package.json": "./package.json",
    "./engines/hls": "./src/engines/hls.ts",
    "./engines/dash": "./src/engines/dash.ts",
    "./engines/flv": "./src/engines/flv.ts",
    "./engines/native": "./src/engines/native.ts"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "keywords": [
    "react",
    "video",
    "player",
    "media",
    "hls",
    "dash",
    "flv",
    "audio"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "clean": "rimraf coverage"
  },
  "dependencies": {
    "react-icons": "^5.5.0",
    "hls.js": "^1.7.3",
    "dashjs": "^5.2.1",
    "mpegts.js": "^1.8.2"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "catalog:web",
    "@types/react-dom": "catalog:web",
    "react": "catalog:web",
    "react-dom": "catalog:web",
    "cross-spawn": "^7.0.6",
    "@types/cross-spawn": "^6.0.6"
  },
  "license": "MIT"
}
