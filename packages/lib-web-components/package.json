{
  "name": "@minerva/lib-web-components",
  "version": "0.0.1",
  "description": "Minerva Web Components built with Lit",
  "license": "MIT",
  "author": "fwx5618177 <fwx5618177@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fwx5618177/minerva.git",
    "directory": "packages/lib-web-components"
  },
  "homepage": "https://fwx5618177.github.io/minerva/",
  "keywords": [
    "web-components",
    "lit",
    "custom-elements"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts"
      },
      "require": {
        "types": "./dist/react.d.cts"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": true,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist coverage",
    "check:package": "publint && attw --pack ."
  },
  "dependencies": {
    "lit": "^3.3.0"
  },
  "peerDependencies": {
    "@types/react": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react.d.ts"
      ]
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
