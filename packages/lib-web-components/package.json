  "files": [
    "dist",
    "custom-elements.json",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "dist/index.js",
    "dist/elements/*.js",
    "dist/cdn/*.js",
    "src/index.ts",
    "src/elements/*.ts",
    "*.css"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "(cd ../core && vite build) && vite build && vite build --config vite.cdn.config.ts && node scripts/generate-typings.mjs",
    "watch": "vite build --watch",
    "test": "vitest run",
    "test:dist": "vitest run --config vitest.dist.config.ts",
    "manifest": "node scripts/generate-manifest.mjs",
    "sync:package": "node scripts/sync-package.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist coverage",
    "check:package": "publint && attw --pack . --profile esm-only --exclude-entrypoints ./tokens.css ./custom-elements.json ./html-custom-data.json ./cdn"
  },
