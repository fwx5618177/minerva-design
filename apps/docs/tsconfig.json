{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "react-jsx",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "types": ["node"],
    "strict": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"],
      "@components/*": ["./src/components/*"],
      "@layout/*": ["./src/layout/*"],
      "@pages/*": ["./src/pages/*"],
      "@styles/*": ["./src/styles/*"],
      "@i18n/*": ["./src/i18n/*"],
      "@router/*": ["./src/router/*"],
      "@contracts": ["../../packages/core/src/contracts/index.ts"],
      "minerva-design": ["../../packages/react/src/index.ts"],
      "minerva-design/theme-utils": ["../../packages/react/src/theme-utils.ts"],
      "minerva-design/utils": ["../../packages/react/src/utils-entry.ts"],
      "minerva-design/monaco": ["../../packages/react/src/monaco.ts"],
      "minerva-design/styling-hooks": ["../../packages/core/src/styling-hooks/index.ts"],
      "minerva-design/core": ["../../packages/dom/src/core-web.ts"],
      "minerva-design/web-components": ["../../packages/web-components/src/index.ts"],
      "minerva-design/vue": ["../../packages/vue/src/index.ts"],
      "@react-styles/*": ["../../packages/react/src/*"],
      "minerva-design/web-components/*": ["../../packages/web-components/src/elements/*.ts"],
      "minerva-design/native": ["../../packages/native/src/index.ts"],
      "react-native": ["../../packages/native/node_modules/react-native/types"],
      "react": ["../../node_modules/@types/react"],
      "react/*": ["../../node_modules/@types/react/*"]
    },
    "noUncheckedSideEffectImports": false
  },
  "include": ["src", "global.d.ts", "vite.config.ts"]
}
