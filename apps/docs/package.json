{
  "name": "@minerva/docs",
  "version": "0.1.0",
  "private": true,
  "description": "Documentation and demo site of minerva-design (private, deployed to GitHub Pages)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "node scripts/generate-api.mjs && node scripts/generate-vue-api.mjs && node scripts/generate-mini-api.mjs && node ../../packages/angular/scripts/generate-api.mjs && vite build",
    "typecheck": "node ../../packages/angular/scripts/docs-aot.mjs && tsc --noEmit && vue-tsc --noEmit -p tsconfig.vue-examples.json",
    "clean": "rimraf dist",
    "gen:api": "node scripts/generate-api.mjs && node scripts/generate-vue-api.mjs && node scripts/generate-mini-api.mjs && node ../../packages/angular/scripts/generate-api.mjs",
    "check:mini-api": "node scripts/generate-mini-api.mjs --check",
    "typecheck:vue": "vue-tsc --noEmit -p tsconfig.vue-examples.json"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "i18next": "^26.4.2",
    "minerva-design": "workspace:*",
    "monaco-editor": "0.52.2",
    "prismjs": "^1.30.0",
    "react": "catalog:web",
    "react-dom": "catalog:web",
    "react-i18next": "^17.0.0",
    "react-icons": "^5.7.0",
    "react-router": "^7.18.4",
    "vue": "catalog:vue",
    "react-native-web": "catalog:native",
    "@angular/common": "catalog:angular",
    "@angular/compiler": "catalog:angular",
    "@angular/core": "catalog:angular",
    "@angular/forms": "catalog:angular",
    "@angular/platform-browser": "catalog:angular",
    "rxjs": "catalog:angular"
  },
  "devDependencies": {
    "@types/prismjs": "^1.26.3",
    "@vitejs/plugin-vue": "catalog:vue",
    "vue-component-meta": "catalog:vue",
    "vue-tsc": "catalog:vue"
  }
}
