{
  "name": "minerva",
  "private": true,
  "description": "Monorepo of minerva-design (React 19 components, native Vue 3 components and Web Components)",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter minerva-design build && pnpm --filter @minerva/docs dev",
    "build": "pnpm --filter minerva-design build && pnpm --filter @minerva/docs build",
    "preview": "pnpm --filter @minerva/docs preview",
    "test": "vitest run",
    "test:unit": "vitest run --project core --project dom --project react --project web-components --project vue --project docs-app --project docs",
    "test:e2e": "vitest run --project e2e",
    "test:contracts": "vitest run --project contracts",
    "test:dist": "pnpm --filter minerva-design test:dist",
    "check:package": "pnpm --filter minerva-design check:package",
    "test:watch": "vitest",
    "hooks:lock": "pnpm --filter @minerva/core hooks:lock",
    "gen:contracts": "node tools/generate-contracts.mjs",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm -r typecheck && tsc -p tests/e2e --noEmit && tsc -p tests/docs --noEmit && tsc -p tests/contracts --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "pnpm -r clean && rimraf node_modules coverage",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm --filter minerva-design build && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "catalog:web",
    "@types/react-dom": "catalog:web",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-vue": "catalog:vue",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/test-utils": "catalog:vue",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "publint": "^0.3.25",
    "react": "catalog:web",
    "react-dom": "catalog:web",
    "rimraf": "^6.1.3",
    "sass": "^1.105.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.3",
    "vue": "catalog:vue"
  },
  "lint-staged": {
    "{apps,packages}/*/src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,ts,json,md,yml,yaml,scss}": "prettier --write"
  }
}
