{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "strict": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "noEmit": true,
    "paths": {
      "minerva-design": ["../../packages/react/src/index.ts"],
      "minerva-design/theme-utils": ["../../packages/react/src/theme-utils.ts"],
      "minerva-design/utils": ["../../packages/react/src/utils-entry.ts"],
      "minerva-design/monaco": ["../../packages/react/src/monaco.ts"],
      "minerva-design/web-components": ["../../packages/web-components/src/index.ts"],
      "minerva-design/vue": ["../../packages/vue/src/index.ts"],
      "minerva-design/styling-hooks": ["../../packages/core/src/styling-hooks/index.ts"],
      "@minerva/core": ["../../packages/core/src/index.ts"],
      "@minerva/dom": ["../../packages/dom/src/index.ts"],
      "@minerva/core/styling-hooks": ["../../packages/core/src/styling-hooks/index.ts"],
      "@minerva/core/contracts": ["../../packages/core/src/contracts/index.ts"]
    }
  },
  "include": ["."]
}
