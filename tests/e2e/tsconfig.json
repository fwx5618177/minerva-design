{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "strict": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "noEmit": true,
    "paths": {
      "@minerva/lib-core": ["../../packages/lib-core/src/index.ts"],
      "@minerva/lib-core/theme-utils": ["../../packages/lib-core/src/theme-utils.ts"],
      "@minerva/lib-core/monaco": ["../../packages/lib-core/src/monaco.ts"],
      "@minerva/lib-web-components": ["../../packages/lib-web-components/src/index.ts"],
      "@minerva/core": ["../../packages/core/src/index.ts"]
    }
  },
  "include": ["."]
}
